<Page
    x:Class="Advance_Control.Views.Pages.DevOpsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Herramientas DevOps" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Limpieza de datos por módulo para entregar sistema limpio al usuario final."
                       Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Barra de estado -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Botones de limpieza -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,24">
            <!-- Modo pruebas: el botón más delicado (solo nivel 1) -->
            <Border Padding="16" Margin="0,0,0,16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Modo pruebas" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ModoPruebasEstadoText" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Activo: solo usuarios nivel 1 entran a Advance Control; en el portal solo el cliente de prueba (se genera si no existe); no se timbra ni se cancela ante el SAT; los correos solo salen a contactos del cliente de prueba. Al desactivar se borra el cliente de prueba con todo lo suyo, se reinician las semillas y se reabre el sistema. No se desactiva solo." />
                    </StackPanel>
                    <Button x:Name="BtnModoPruebas" Grid.Column="1" VerticalAlignment="Center" Padding="16,12"
                            Click="OnModoPruebasClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ModoPruebasIcon" Glyph="&#xE72E;" FontSize="16" />
                            <TextBlock x:Name="ModoPruebasBotonText" Text="Activar modo pruebas" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="Operaciones de limpieza" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fila 1 -->
                <Button x:Name="BtnFinanciero" Grid.Row="0" Grid.Column="0"
                        HorizontalAlignment="Stretch" Margin="0,0,4,4" Padding="16,12"
                        Click="OnLimpiarFinancieroClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BF;" FontSize="16" />
                        <TextBlock Text="Borrado Financiero" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOperaciones" Grid.Row="0" Grid.Column="1"
                        HorizontalAlignment="Stretch" Margin="4,0,4,4" Padding="16,12"
                        Click="OnLimpiarOperacionesClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE821;" FontSize="16" />
                        <TextBlock Text="Borrado Operaciones" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnMantenimiento" Grid.Row="0" Grid.Column="2"
                        HorizontalAlignment="Stretch" Margin="4,0,0,4" Padding="16,12"
                        Click="OnLimpiarMantenimientoClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE90F;" FontSize="16" />
                        <TextBlock Text="Borrado Mantenimiento" />
                    </StackPanel>
                </Button>

                <!-- Fila 2 -->
                <Button x:Name="BtnLevantamientos" Grid.Row="1" Grid.Column="0"
                        HorizontalAlignment="Stretch" Margin="0,4,4,0" Padding="16,12"
                        Click="OnLimpiarLevantamientosClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70B;" FontSize="16" />
                        <TextBlock Text="Borrado Levantamientos" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnServicios" Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Stretch" Margin="4,4,4,0" Padding="16,12"
                        Click="OnLimpiarServiciosClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE90F;" FontSize="16" />
                        <TextBlock Text="Borrado Servicios" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnLogs" Grid.Row="1" Grid.Column="2"
                        HorizontalAlignment="Stretch" Margin="4,4,0,0" Padding="16,12"
                        Click="OnLimpiarLogsClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                        <TextBlock Text="Borrado Logs" />
                    </StackPanel>
                </Button>

                <!-- Fila 3 -->
                <Button x:Name="BtnUbicaciones" Grid.Row="2" Grid.Column="0"
                        HorizontalAlignment="Stretch" Margin="0,4,4,0" Padding="16,12"
                        Click="OnLimpiarUbicacionesClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE707;" FontSize="16" />
                        <TextBlock Text="Borrado Ubicaciones" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPermisos" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch" Margin="4,4,0,0" Padding="16,12"
                        Background="#8B5CF6" Foreground="White"
                        Click="OnLimpiarPermisosClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                        <TextBlock Text="Resetear y Regenerar Permisos" />
                    </StackPanel>
                </Button>

                <!-- Fila 4 -->
                <Button x:Name="BtnConciliacionRango" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="16,12"
                        Background="#CC4A1A" Foreground="White"
                        Click="OnLimpiarConciliacionRangoClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE738;" FontSize="16" />
                        <TextBlock Text="Borrar Conciliación por Rango de Fechas" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Botón de estadísticas -->
            <Button x:Name="BtnEstadisticas" Margin="0,8,0,0" Padding="16,12"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnCargarEstadisticasClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                    <TextBlock Text="Ver Estadísticas de BD" />
                </StackPanel>
            </Button>

            <!-- Herramientas de facturación -->
            <TextBlock Text="Herramientas de Facturación" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

            <Button x:Name="BtnDesvincularFacturas" Padding="16,12"
                    Click="OnDesvincularFacturasClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71B;" FontSize="16" />
                    <TextBlock Text="Desvincular Todas las Facturas" />
                </StackPanel>
            </Button>

            <!-- Cliente de prueba del Portal de Clientes -->
            <TextBlock Text="Cliente de Prueba (Portal de Clientes)" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="CLIENTE DE PRUEBA SA DE CV (RFC PRU260101AB1): contactos, logins del portal (prueba.dirigido / prueba.admin, contraseña Prueba2026!), equipos, órdenes de servicio, cotizaciones, hoja de mantenimiento, factura ficticia y emergencia, todo dirigido a Ing. Braulio Emiliano Vazquez Valdez." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnGenerarPrueba" Padding="16,12" Click="OnGenerarClientePruebaClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FA;" FontSize="16" />
                        <TextBlock Text="Generar cliente de prueba" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnBorrarPrueba" Padding="16,12" Click="OnBorrarClientePruebaClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        <TextBlock Text="Borrar cliente de prueba" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnReiniciarSemillas" Padding="16,12" Click="OnReiniciarSemillasClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Reiniciar semillas" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Herramientas de mensajería -->
            <TextBlock Text="Herramientas de Mensajería" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

            <Button x:Name="BtnMensajePrueba" Padding="16,12"
                    Click="OnEnviarMensajePruebaClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE89B;" FontSize="16" />
                    <TextBlock Text="Enviar Mensaje de Prueba" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Tabla de estadísticas / resultados -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Estadísticas -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Estadísticas de BD" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                <ListView ItemsSource="{x:Bind ViewModel.Estadisticas, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Tabla}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalRegistros}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Últimos resultados de limpieza -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Último resultado" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                <ListView ItemsSource="{x:Bind ViewModel.UltimosResultados, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Tabla}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding RegistrosEliminados}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
