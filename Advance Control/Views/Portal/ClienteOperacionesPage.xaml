<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Advance_Control.Views.Portal.ClienteOperacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Mis operaciones" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Toca una operación para ver el detalle y sus hojas de mantenimiento preventivo." />
        </StackPanel>

        <ProgressRing
            x:Name="CargandoProgressRing"
            Grid.Row="1"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />

        <TextBlock
            x:Name="SinOperacionesTextBlock"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No tienes operaciones registradas todavía."
            Visibility="Collapsed" />

        <ListView
            x:Name="OperacionesListView"
            Grid.Row="1"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OperacionesListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:OperacionClientePortalDto">
                    <Border
                        Margin="0,0,0,8"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Identificador}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Nota}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasNota}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                    <Run Text="Operación #" />
                                    <Run Text="{x:Bind IdOperacion}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                <Border
                                    Padding="8,3"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind Pendiente}">
                                    <TextBlock FontSize="11" Text="Pendiente" />
                                </Border>
                                <Border
                                    Padding="8,3"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind TecnicamenteFinalizada}">
                                    <TextBlock FontSize="11" Text="Finalizada" />
                                </Border>
                                <Border
                                    Padding="8,3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind Facturada}">
                                    <TextBlock FontSize="11" Foreground="White" Text="Facturada" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
