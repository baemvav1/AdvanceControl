                                <TextBox
                                    x:Name="Txt_Comentarios"
                                    Height="150"
                                    AcceptsReturn="True"
                                    PlaceholderText="Escribe aquí observaciones, material utilizado o irregularidades..."
                                    TextWrapping="Wrap" />

                                <!--  ===================== SITUACIÓN FINAL DEL EQUIPO =====================  -->
                                <Border Style="{StaticResource SeccionHeaderStyle}">
                                    <TextBlock Style="{StaticResource SeccionHeaderTextStyle}" Text="Situación final del equipo" />
                                </Border>
                                <StackPanel
                                    Margin="0,4,0,8"
                                    Orientation="Horizontal"
                                    Spacing="24">
                                    <RadioButton
                                        x:Name="Rb_Operativo"
                                        Content="Operativo"
                                        GroupName="SituacionFinal" />
                                    <RadioButton
                                        x:Name="Rb_Detenido"
                                        Content="Detenido"
                                        GroupName="SituacionFinal" />
                                </StackPanel>
                                <TextBox
                                    x:Name="Txt_SituacionFinal"
                                    Height="100"
                                    AcceptsReturn="True"
                                    PlaceholderText="Describe la situación final del equipo..."
                                    TextWrapping="Wrap" />

                                <!--  ===================== FIRMAS =====================  -->
