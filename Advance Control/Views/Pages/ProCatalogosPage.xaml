<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.ProCatalogosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:Advance_Control.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <!--
        El diseño del buscador vive en Views/Dialogs/BuscadorEquiposUserControl.xaml
        (es el mismo que se abre como modal en toda la app). Aquí se muestra en línea para
        seguir ajustándolo, y el botón lo abre como modal real.
    -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            HorizontalAlignment="Left"
            Click="AbrirModal_Click"
            Content="Abrir como modal" />

        <dialogs:BuscadorEquiposUserControl
            x:Name="Buscador"
            Grid.Row="1"
            Cancelado="Buscador_Cancelado"
            EquipoSeleccionado="Buscador_EquipoSeleccionado" />
    </Grid>
</Page>
