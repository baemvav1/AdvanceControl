<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Advance_Control.Views.Pages.FacturasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Advance_Control.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Encabezado: buscador + filtros  -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Facturas CFDI" />
                    <Button
                        Click="BtnCargarFacturaXml_Click"
                        Content="Cargar XML"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        ToolTipService.ToolTip="Cargar una factura ya timbrada en el sistema web del proveedor (folio suelto, sin serie)" />
                    <Button
                        Click="BtnCargarMultiplesFacturas_Click"
                        Content="Subir varios XML"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        ToolTipService.ToolTip="Cargar en lote varias facturas ya timbradas en el sistema web del proveedor" />
                    <Button
                        Click="BtnConsolidarComplementos_Click"
                        Content="Consolidar Complementos"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        ToolTipService.ToolTip="Detecta Complementos de Pago sin procesar, los vincula a su factura y propone ligarlos a su movimiento bancario -- todo el proceso que antes se hacía a mano" />
                </StackPanel>

                <!--  Renglón 1: buscador + tipo de factura  -->
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="16"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="BusquedaAutoSuggestBox"
                        Grid.Column="0"
                        DisplayMemberPath="SugerenciaTexto"
                        ItemsSource="{x:Bind ViewModel.Sugerencias, Mode=OneWay}"
                        PlaceholderText="Buscar por receptor, UUID o folio (Serie + folio o solo folio)…"
                        QueryIcon="Find"
                        QuerySubmitted="BusquedaAutoSuggestBox_QuerySubmitted"
                        TextChanged="BusquedaAutoSuggestBox_TextChanged" />

                    <CheckBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="Con serie + folio"
                        IsChecked="{x:Bind ViewModel.IncluirConSerie, Mode=TwoWay}"
                        ToolTipService.ToolTip="Facturas generadas por el software (Serie A + folio propio)" />

                    <CheckBox
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="Sin serie (solo folio)"
                        IsChecked="{x:Bind ViewModel.IncluirSinSerie, Mode=TwoWay}"
                        ToolTipService.ToolTip="Facturas emitidas manualmente desde el portal de Bilkon, identificadas solo por folio" />

                    <CheckBox
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="Complementos de pago"
                        IsChecked="{x:Bind ViewModel.IncluirComplementosPago, Mode=TwoWay}"
                        ToolTipService.ToolTip="CFDI de tipo Pago (P)" />
                </Grid>

                <!--  Renglón 2: rango de fechas + acciones  -->
                <Grid
                    Grid.Row="2"
                    ColumnSpacing="16"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CalendarDatePicker
                        x:Name="FechaDesdeDatePicker"
                        Grid.Column="0"
                        Width="220"
                        Header="Desde"
                        Date="{x:Bind ViewModel.FechaDesde, Mode=TwoWay}" />

                    <CalendarDatePicker
                        x:Name="FechaHastaDatePicker"
                        Grid.Column="1"
                        Width="220"
                        Header="Hasta"
                        Date="{x:Bind ViewModel.FechaHasta, Mode=TwoWay}" />

                    <Button
                        x:Name="BtnBuscar"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Click="BtnBuscar_Click"
                        Content="Buscar"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        Style="{StaticResource AccentButtonStyle}" />

                    <Button
                        x:Name="BtnLimpiarFiltros"
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Click="BtnLimpiarFiltros_Click"
                        Content="Limpiar filtros"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                </Grid>
            </Grid>
        </Border>

        <!--  Estado: cargando / mensajes  -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Grid.Column="0"
                Width="28"
                Height="28"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <StackPanel Grid.Column="1">
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <InfoBar
                    Margin="0,8,0,0"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                    Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                    Severity="Success" />
            </StackPanel>
        </Grid>

        <!--  Listado de facturas  -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="FacturasListView"
                Padding="0,0,4,0"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.FacturasPagina, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FacturaResumenDto">
                        <Border
                            Margin="0,0,0,10"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Información principal  -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding FolioTitulo}" />

                                        <Border
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock FontSize="11" Text="{Binding TipoFacturaTexto}" />
                                        </Border>

                                        <Border
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock FontSize="11" Text="{Binding EstadoPagoTexto}" />
                                        </Border>

                                        <Border
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding Cancelada, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock FontSize="11" Text="{Binding EstadoCancelacionTexto}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock FontWeight="SemiBold" Text="{Binding ReceptorNombre}" TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding RfcTexto}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding FechaTexto}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding UuidTexto}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <!--  Total + acciones  -->
                                <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="{Binding TotalTexto}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SaldoPendienteTexto}" />

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Click="BtnDescargarPdf_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Descargar PDF">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                                <TextBlock Text="PDF" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Click="BtnDescargarXml_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Descargar XML">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                                <TextBlock Text="XML" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Click="BtnComplementoPago_Click"
                                            IsEnabled="{Binding PermiteGestionInterna}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="{Binding TooltipCapturarPagoTexto}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock Text="Registrar abono" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Click="BtnGenerarComplementoPago_Click"
                                            IsEnabled="{Binding PuedeGenerarComplementoPago}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="{Binding TooltipGenerarComplementoTexto}"
                                            Visibility="{Binding PuedeGenerarComplementoPago, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE9F5;" />
                                                <TextBlock Text="Generar complemento de pago" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Click="BtnCancelar_Click"
                                            IsEnabled="{Binding PuedeCancelarCfdi}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="{Binding TooltipCancelarTexto}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                                                <TextBlock Text="Cancelar" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Click="BtnComprobanteCancelacion_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Descargar acuse de cancelación (SAT)"
                                            Visibility="{Binding Cancelada, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                                <TextBlock Text="Acuse" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Click="BtnAbrir_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Abrir detalle de la factura">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                                <TextBlock Text="Abrir" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.SinResultados, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ResumenPaginacionTexto, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  Footer: paginación y totales  -->
        <Border
            Grid.Row="3"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ResumenPaginacionTexto, Mode=OneWay}" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Click="BtnPaginaAnterior_Click"
                        Content="◀ Anterior"
                        IsEnabled="{x:Bind ViewModel.PuedeIrAnterior, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PaginaTexto, Mode=OneWay}" />
                    <Button
                        Click="BtnPaginaSiguiente_Click"
                        Content="Siguiente ▶"
                        IsEnabled="{x:Bind ViewModel.PuedeIrSiguiente, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
