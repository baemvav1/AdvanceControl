<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Advance_Control.Views.Portal.ClienteHojaMantenimientoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Margin="0,0,0,12"
            HorizontalAlignment="Left"
            Click="VolverButton_Click"
            Content="&lt; Volver a la operación" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Hoja de mantenimiento preventivo" />
                        <TextBlock x:Name="EstadoTextBlock" FontSize="13" />
                        <TextBlock x:Name="ResumenTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ObservacionesTextBlock" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="SeccionesPanel" Spacing="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="8">
            <InfoBar x:Name="MensajeInfoBar" IsClosable="False" IsOpen="False" />
            <Button
                x:Name="FirmarButton"
                HorizontalAlignment="Right"
                Click="FirmarButton_Click"
                Content="Aprobar / Firmar"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
