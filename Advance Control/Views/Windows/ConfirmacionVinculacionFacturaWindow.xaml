<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Advance_Control.Views.Windows.ConfirmacionVinculacionFacturaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Contenido: lista de propuestas  -->
        <ScrollViewer
            Grid.Row="0"
            Padding="20,16,20,0"
            VerticalScrollBarVisibility="Auto">
            <ListView
                x:Name="ListaPropuestas"
                SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="8,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Operación sin factura" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Monto antes de IVA" />
                        <TextBlock
                            Grid.Column="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Factura a vincular" />
                    </Grid>
                </ListView.Header>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Margin="0,5,0,0"
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="8"
                            CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Aprobado, Mode=TwoWay}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Operacion.RazonSocial}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Operacion.Identificador}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{Binding Operacion.IdOperacionTexto}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Operacion.MontoTexto}" />

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <!--  Un solo candidato: texto fijo  -->
                                <StackPanel
                                    Spacing="2"
                                    Visibility="{Binding TieneMultiplesCandidatas, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding FacturaSeleccionada.FolioTitulo}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding FacturaSeleccionada.SubTotalTexto}" />
                                </StackPanel>

                                <!--  Varios candidatos con el mismo RFC y monto: hay que elegir cual  -->
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding Candidatas}"
                                    SelectedItem="{Binding FacturaSeleccionada, Mode=TwoWay}"
                                    Visibility="{Binding TieneMultiplesCandidatas, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FolioTitulo}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding FechaTexto}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!--  Footer con resumen y botones  -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TxtResumen"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="BtnCancelar" Click="BtnCancelar_Click" Content="Cancelar" />
                    <Button
                        x:Name="BtnConfirmar"
                        Click="BtnConfirmar_Click"
                        Content="Vincular seleccionadas"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
