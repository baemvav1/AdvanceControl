                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Presencia agua en cuarto de máquinas" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCuartoMaq_NoAplica"
