<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.DetalleClientesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    xmlns:sp="using:ScottPlot.WinUI"
    xmlns:vm="using:Advance_Control.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="Detalle Clientes" />
        </Grid>

        <Grid Grid.Row="1" x:Name="Kpis" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{x:Bind ViewModel.KpisActuales, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:KpiItem">
                        <Border
                            MinWidth="160"
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind ColorValorBrush}"
                                    Text="{x:Bind Valor}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Etiqueta}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="Listado"
                Grid.Column="0"
                Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    PlaceholderText="Buscar por RFC o razón social..."
                    Text="{x:Bind ViewModel.BusquedaTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ProgressRing
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Clientes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClienteSaludCardItem">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{x:Bind ColorSaludBrush}"
                                    CornerRadius="8"
                                    Tag="{x:Bind}"
                                    Tapped="ClienteCard_Tapped">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#202020"
                                            Text="{x:Bind RazonSocial}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock Foreground="#202020" Text="{x:Bind Rfc}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Grid
                x:Name="Detalle"
                Grid.Column="1"
                Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressRing
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoadingDetalle, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingDetalle, Mode=OneWay}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Selecciona un cliente del listado para ver su detalle."
                    Visibility="{x:Bind ViewModel.TieneClienteSeleccionado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                <ScrollViewer Visibility="{x:Bind ViewModel.TieneClienteSeleccionado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TreeView
                        x:Name="DetalleTreeView"
                        ItemsSource="{x:Bind ViewModel.DetalleTreeItems, Mode=OneWay}"
                        SelectionChanged="DetalleTreeView_SelectionChanged"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:DetalleClienteTreeItem">
                                <TreeViewItem IsExpanded="True" ItemsSource="{x:Bind Hijos}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind ColorTextoBrush}"
                                            Text="{x:Bind Etiqueta}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ValorTexto}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Grid>
            <Grid
                x:Name="Graficos"
                Grid.Column="2"
                Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TimelineTitulo, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Selecciona una rama del árbol de detalle para ver su timeline."
                    Visibility="{x:Bind ViewModel.TieneTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                <sp:WinUIPlot
                    x:Name="GraficoPlot"
                    Grid.Row="1"
                    Visibility="{x:Bind ViewModel.TieneTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
