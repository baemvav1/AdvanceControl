<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.LevantamientoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">


    <Page.Resources>

        <!--  ===================== ESTILOS BASE =====================  -->

        <Style x:Key="SeccionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style x:Key="SeccionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ColumnaHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="ItemTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ItemCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ItemRowBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,6" />
        </Style>

        <!--  Definición de columnas reutilizable para cada tabla de checklist  -->
        <GridLength x:Key="ColAnchoCheck">70</GridLength>

    </Page.Resources>


    <Grid>
        <!--  Pantalla en reconstruccion: ver endpointsLevantamientoPendientes.md en la raiz del repo.  -->



        <TabView VerticalAlignment="Stretch">
            <TabViewItem Header="Elevador" IsClosable="False">
                <TabViewItem.Content>
                    <Grid>
                        <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                HorizontalAlignment="Stretch"
                                Spacing="4">

                                <!--  ===================== TIPO DE EQUIPO =====================  -->
                                <Border
                                    Padding="12,10"
                                    Background="#F2F2F2"
                                    CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Tipo de equipo:" />
                                        <RadioButton
                                            x:Name="Rb_SalaDeMaquinas"
                                            Content="Sala de Máquinas"
                                            GroupName="TipoEquipo" />
                                        <RadioButton
                                            x:Name="Rb_SinSalaDeMaquinas"
                                            Content="Sin Sala de Máquinas"
                                            GroupName="TipoEquipo" />
                                        <RadioButton
                                            x:Name="Rb_Hidraulico"
                                            Content="Hidráulico"
                                            GroupName="TipoEquipo" />
                                    </StackPanel>
                                </Border>

                                <!--  ===================== CABINA =====================  -->
                                <Border Style="{StaticResource SeccionHeaderStyle}">
                                    <TextBlock Style="{StaticResource SeccionHeaderTextStyle}" Text="CABINA" />
                                </Border>

                                <Grid x:Name="Grid_Cabina">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Encabezado de columnas  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="No aplica" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Verificación" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Ajuste" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Limpieza" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="5"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Lubricación" />

                                    <!--  Botonera e indicadores  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Botonera e indicadores" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Botonera_NoAplica"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Botonera_Verificacion"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Botonera_Ajuste"
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Botonera_Limpieza"
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Botonera_Lubricacion"
                                        Grid.Row="1"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Alarma y/o intercomunicador  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Alarma y/o intercomunicador" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Alarma_NoAplica"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Alarma_Verificacion"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Alarma_Ajuste"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Alarma_Limpieza"
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Alarma_Lubricacion"
                                        Grid.Row="2"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Puertas corredizas y fotoceldas  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Puertas corredizas y fotoceldas" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Puertas_NoAplica"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Puertas_Verificacion"
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Puertas_Ajuste"
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Puertas_Limpieza"
                                        Grid.Row="3"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Puertas_Lubricacion"
                                        Grid.Row="3"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Estado general de la cabina  -->
                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Estado general de la cabina" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Estado_NoAplica"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Estado_Verificacion"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Estado_Ajuste"
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Estado_Limpieza"
                                        Grid.Row="4"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Estado_Lubricacion"
                                        Grid.Row="4"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Confort  -->
                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Confort" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Confort_NoAplica"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Confort_Verificacion"
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Confort_Ajuste"
                                        Grid.Row="5"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Confort_Limpieza"
                                        Grid.Row="5"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Confort_Lubricacion"
                                        Grid.Row="5"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Iluminación de emergencia  -->
                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Iluminación de emergencia" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Iluminacion_NoAplica"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Iluminacion_Verificacion"
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Iluminacion_Ajuste"
                                        Grid.Row="6"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Iluminacion_Limpieza"
                                        Grid.Row="6"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Iluminacion_Lubricacion"
                                        Grid.Row="6"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Comando dentro de cabina  -->
                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Comando dentro de cabina" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Comando_NoAplica"
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Comando_Verificacion"
                                        Grid.Row="7"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Comando_Ajuste"
                                        Grid.Row="7"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Comando_Limpieza"
                                        Grid.Row="7"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Comando_Lubricacion"
                                        Grid.Row="7"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Limpieza de sardinel  -->
                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Limpieza de sardinel" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Sardinel_NoAplica"
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Sardinel_Verificacion"
                                        Grid.Row="8"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Sardinel_Ajuste"
                                        Grid.Row="8"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Sardinel_Limpieza"
                                        Grid.Row="8"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Cabina_Sardinel_Lubricacion"
                                        Grid.Row="8"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                </Grid>

                                <!--  ===================== CUARTO DE MÁQUINAS =====================  -->
                                <Border Style="{StaticResource SeccionHeaderStyle}">
                                    <TextBlock Style="{StaticResource SeccionHeaderTextStyle}" Text="CUARTO DE MÁQUINAS" />
                                </Border>

                                <Grid x:Name="Grid_CuartoMaquinas">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColAnchoCheck}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="No aplica" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Verificación" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Ajuste" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Limpieza" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="5"
                                        Style="{StaticResource ColumnaHeaderTextStyle}"
                                        Text="Lubricación" />

                                    <!--  Limpieza del cuarto de máquina  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Limpieza del cuarto de máquina" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Limpieza_NoAplica"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Limpieza_Verificacion"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Limpieza_Ajuste"
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Limpieza_Limpieza"
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Limpieza_Lubricacion"
                                        Grid.Row="1"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Máquina y cables de tracción  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Máquina y cables de tracción" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Maquina_NoAplica"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Maquina_Verificacion"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Maquina_Ajuste"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Maquina_Limpieza"
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Maquina_Lubricacion"
                                        Grid.Row="2"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Verificar nivel de aceite (si aplica)  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Verificar nivel de aceite (si aplica)" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_NivelAceite_NoAplica"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_NivelAceite_Verificacion"
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_NivelAceite_Ajuste"
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_NivelAceite_Limpieza"
                                        Grid.Row="3"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_NivelAceite_Lubricacion"
                                        Grid.Row="3"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Conjunto de freno y contactos BK  -->
                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Conjunto de freno y contactos BK" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Freno_NoAplica"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Freno_Verificacion"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Freno_Ajuste"
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Freno_Limpieza"
                                        Grid.Row="4"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Freno_Lubricacion"
                                        Grid.Row="4"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Regulador de velocidad  -->
                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Regulador de velocidad" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Regulador_NoAplica"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Regulador_Verificacion"
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Regulador_Ajuste"
                                        Grid.Row="5"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Regulador_Limpieza"
                                        Grid.Row="5"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Regulador_Lubricacion"
                                        Grid.Row="5"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Intercomunicador  -->
                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Intercomunicador" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Intercomunicador_NoAplica"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Intercomunicador_Verificacion"
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Intercomunicador_Ajuste"
                                        Grid.Row="6"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_CuartoMaq_Intercomunicador_Limpieza"
                                        Grid.Row="6"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
