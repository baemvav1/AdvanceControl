                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Spacing="4">
                                        <Border
                                            x:Name="Border_FirmaCliente"
                                            Height="120"
                                            BorderBrush="#AAAAAA"
                                            BorderThickness="1" />
                                        <TextBlock HorizontalAlignment="Center" Text="Firma del cliente" />
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabViewItem.Content>
            </TabViewItem>
            <TabViewItem Header="Escaleras" IsClosable="False">
                <TabViewItem.Content>
                    <StackPanel Padding="12">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Hola" />
                    </StackPanel>
                </TabViewItem.Content>
            </TabViewItem>
            <TabViewItem Header="Recuperacion" IsClosable="False">
                <TabViewItem.Content>
                    <StackPanel Padding="12">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Hola" />
                    </StackPanel>
                </TabViewItem.Content>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
