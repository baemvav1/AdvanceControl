<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.ProFinancieroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="VisorFactura"
            Grid.Column="0"
            Margin="10,10,5,10">
            <Border
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border
                            Grid.Row="0"
                            MinHeight="45"
                            Background="{ThemeResource CardBackgroundFillColorSecondary}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Text="{x:Bind ViewModel.ClienteTexto, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Text="/" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Text="{x:Bind ViewModel.FolioTexto, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <Button
                                        x:Name="DescargaXml"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="DescargaXml_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="XML">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!--  Ícono estándar de descarga (Segoe Fluent Icons)  -->
                                            <FontIcon FontSize="14" Glyph="&#xE943;" />

                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="DescargaPDF"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="DescargaPDF_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="PDF">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!--  Ícono estándar de descarga (Segoe Fluent Icons)  -->
                                            <FontIcon FontSize="14" Glyph="&#xEA90;" />

                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="DescargaZip"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="ZIP (pendiente de diseñar, no existe hoy en el sistema)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!--  Ícono estándar de descarga (Segoe Fluent Icons)  -->
                                            <FontIcon FontSize="14" Glyph="&#xF012;" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="EnvioCorreo"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Enviar por correo (pendiente de diseñar, no existe hoy en el sistema)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!--  Ícono estándar de descarga (Segoe Fluent Icons)  -->
                                            <FontIcon FontSize="14" Glyph="&#xE724;" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>


                        </Border>

                    </Grid>
                    <Grid Grid.Row="1">
                        <ProgressRing
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasPdf, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel
                                x:Name="PdfPagesPanel"
                                Padding="12"
                                Spacing="12" />
                        </ScrollViewer>
                    </Grid>
                    <Border
                        Grid.Row="2"
                        MinHeight="30"
                        Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                        CornerRadius="0,0,0,0">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="{x:Bind ViewModel.EstadoTexto, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>


        </Grid>
        <Grid Grid.Column="1" Margin="5,10,10,10">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Datos Financieros" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Margin="10,0,5,0"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Total" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Factura.TotalTexto, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Margin="5,0,5,0"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Pagado" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="#107C10"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.PagadoTexto, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="2"
                                Margin="5,0,10,0"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Restante" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#D83B01"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.RestanteTexto, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <Button
                                x:Name="BtnRegistrarAbono"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="10,0,5,0"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                Click="RegistrarAbono_Click"
                                Content="Registrar Abono" />
                            <Button
                                x:Name="BtnGenerarComplemento"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="5,0,10,0"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                Click="GenerarComplemento_Click"
                                Content="Generar Complemento" />
                            <Button
                                x:Name="BtnEnviarHistorial"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="10,0,5,0"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                Content="Enviar Historial"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Pendiente de diseñar, no existe hoy en el sistema" />
                            <Button
                                x:Name="BtnCancelarFactura"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5,0,10,0"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                Click="CancelarFactura_Click"
                                Content="Cancelar Factura" />
                        </Grid>
                    </Grid>
                </Border>
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Complementos de pago" />
                        </Grid>

                        <!--  Cabecera fija (se muestra siempre, aunque no haya complementos registrados)  -->
                        <Grid
                            Grid.Row="1"
                            Margin="10,0,10,0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Folio Pago" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Fecha Pago" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Monto Aplicado" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Forma de pago" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater x:Name="ComplementosRepeater" Margin="10,4,10,10" ItemsSource="{x:Bind ViewModel.ComplementosRelacionados, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComplementoPagoRelacionadoDto">
                                        <Border
                                            Padding="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind FolioTitulo}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind FechaPagoTexto}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind ImpPagadoTexto}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind FormaPagoTexto}" />
                                                <Button
                                                    Grid.Column="4"
                                                    Padding="6"
                                                    Click="ComplementoPdf_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Descargar PDF">
                                                    <FontIcon FontSize="14" Glyph="&#xEA90;" />
                                                </Button>
                                                <Button
                                                    Grid.Column="5"
                                                    Padding="6"
                                                    Click="ComplementoEliminar_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Cancelar este Complemento de Pago ante el SAT">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Page>
