<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Advance_Control.Views.Windows.TimbrarIgualaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <SymbolIcon Symbol="Document" />
                <TextBlock x:Name="TxtTitulo" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="16">

                <!--  Emisor (solo lectura)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Emisor" />
                            <ProgressRing
                                x:Name="EmisorProgressRing"
                                Width="18"
                                Height="18"
                                Margin="4,4,0,0" />
                        </StackPanel>
                        <InfoBar x:Name="EmisorInfoBar" IsOpen="False" />
                        <TextBlock x:Name="TxtEmisorResumen" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!--  Receptor (solo lectura, viene del contrato/cliente)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Receptor" />
                        <InfoBar x:Name="ReceptorInfoBar" IsOpen="False" />
                        <TextBlock x:Name="TxtReceptorResumen" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Forma de pago  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}" Text="Forma de pago" />

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Método de pago:" />
                                <ComboBox x:Name="CmbMetodoPago" HorizontalAlignment="Stretch" SelectionChanged="CmbMetodoPago_SelectionChanged">
                                    <ComboBoxItem Content="PUE - Pago en una sola exhibición" Tag="PUE" />
                                    <ComboBoxItem Content="PPD - Pago en parcialidades o diferido" Tag="PPD" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Forma de pago:" />
                                <ComboBox x:Name="CmbFormaPago" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="01 - Efectivo" Tag="01" />
                                    <ComboBoxItem Content="02 - Cheque nominativo" Tag="02" />
                                    <ComboBoxItem Content="03 - Transferencia electrónica de fondos" Tag="03" />
                                    <ComboBoxItem Content="04 - Tarjeta de crédito" Tag="04" />
                                    <ComboBoxItem Content="28 - Tarjeta de débito" Tag="28" />
                                    <ComboBoxItem Content="99 - Por definir" Tag="99" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Concepto (iguala mensual)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Concepto" />

                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Descripción:" />
                            <TextBox x:Name="TxtDescripcion" IsReadOnly="True" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" Text="Clave de producto/servicio SAT:" />
                                <AutoSuggestBox
                                    x:Name="ProdServBox"
                                    PlaceholderText="Buscar clave SAT"
                                    SuggestionChosen="ProdServBox_SuggestionChosen"
                                    TextChanged="ProdServBox_TextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,0,0,4" Text="Clave de unidad SAT:" />
                                <AutoSuggestBox
                                    x:Name="UnidadBox"
                                    PlaceholderText="Buscar unidad"
                                    SuggestionChosen="UnidadBox_SuggestionChosen"
                                    TextChanged="UnidadBox_TextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="IVA:" />
                                <ComboBox x:Name="CmbTasaIva" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="16% IVA" Tag="0.16" />
                                    <ComboBoxItem Content="8% IVA (franja fronteriza)" Tag="0.08" />
                                    <ComboBoxItem Content="0% IVA (tasa cero)" Tag="0.00" />
                                    <ComboBoxItem Content="Exento / sin impuesto" Tag="" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtMontoResumen" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="EmisionInfoBar" IsOpen="False" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="EmisionProgressRing" Width="20" Height="20" />
                    <Button
                        x:Name="BtnTimbrar"
                        Click="BtnTimbrar_Click"
                        Content="Timbrar"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
