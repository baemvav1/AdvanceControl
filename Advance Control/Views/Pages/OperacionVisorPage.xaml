<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.OperacionVisorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Advance_Control.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    xmlns:tv="using:WinUI.TableView"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            Renglón seleccionado: mismo tinte que en Conciliación
        -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush
                        x:Key="TableViewRowBackgroundSelected"
                        Opacity="0.15"
                        Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush
                        x:Key="TableViewRowBackgroundSelectedPointerOver"
                        Opacity="0.22"
                        Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush
                        x:Key="TableViewRowBackgroundSelectedPressed"
                        Opacity="0.10"
                        Color="{ThemeResource SystemAccentColorLight2}" />
                    <StaticResource x:Key="TableViewRowForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush
                        x:Key="TableViewRowBackgroundSelected"
                        Opacity="0.15"
                        Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush
                        x:Key="TableViewRowBackgroundSelectedPointerOver"
                        Opacity="0.22"
                        Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush
                        x:Key="TableViewRowBackgroundSelectedPressed"
                        Opacity="0.10"
                        Color="{ThemeResource SystemAccentColorDark1}" />
                    <StaticResource x:Key="TableViewRowForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style
                x:Key="BotonAccionIcono"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="header"
            Grid.Row="0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"  Margin="10,0,0,0">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <!--  Número de operación  -->
                    <TextBlock
                        x:Name="NumeroOperacionText"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <!--  Identificador del equipo  -->
                    <TextBlock
                        x:Name="EquipoText"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <!--  Cliente  -->
                    <TextBlock
                        x:Name="ClienteText"
                        MaxWidth="320"
                        VerticalAlignment="Center"
                        FontSize="14"
                        TextTrimming="CharacterEllipsis" />

                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">

                    <!--  A quién va dirigida  -->
                    <ComboBox
                        x:Name="DirigidoCombo"
                        MinWidth="220"
                        VerticalAlignment="Center"
                        DisplayMemberPath="NombreCompleto"
                        PlaceholderText="¿A quién va dirigida?"
                        SelectionChanged="DirigidoCombo_SelectionChanged" />
                    <!--  Estado de la cotización (abierta / cerrada)  -->
                    <TextBlock
                        x:Name="CotizacionEstadoText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="CerrarCotizacionButton"
                        Click="CerrarCotizacionButton_Click"
                        Style="{StaticResource BotonAccionIcono}"
                        ToolTipService.ToolTip="Cerrar cotización: no se editan cargos y el cliente la ve en el portal para aprobarla"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE72E;" />
                    </Button>
                    <Button
                        x:Name="AprobarCotizacionButton"
                        Click="AprobarCotizacionButton_Click"
                        Style="{StaticResource BotonAccionIcono}"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE8FB;" />
                    </Button>
                    <Button
                        x:Name="ReenviarNotificacionButton"
                        Click="ReenviarNotificacionButton_Click"
                        Style="{StaticResource BotonAccionIcono}"
                        ToolTipService.ToolTip="Reenviar notificación de la cotización al cliente"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE724;" />
                    </Button>
                    <!--  Reabre la operación si está finalizada; si no, la cotización cerrada  -->
                    <Button
                        x:Name="ReabrirButton"
                        Click="ReabrirButton_Click"
                        Style="{StaticResource BotonAccionIcono}">
                        <FontIcon FontSize="16" Glyph="&#xE785;" />
                    </Button>
                    <!--  Compartir por chat: modal para elegir contacto y escribir descripción  -->
                    <Button
                        x:Name="CompartirButton"
                        Click="CompartirButton_Click"
                        Style="{StaticResource BotonAccionIcono}"
                        ToolTipService.ToolTip="Compartir la operación por chat">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                    </Button>


                </StackPanel>
            </Grid>

        </Grid>
        <Grid Grid.Row="1" Background="Transparent">
            <!--  Listado de cargos: misma tabla y selección (fijado) que Conciliación  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <tv:TableView
                x:Name="TablaCargos"
                Grid.Column="0"
                Margin="10,5,5,5"
                CornerRadius="8"
                AutoGenerateColumns="False"
                BeginningEdit="TablaCargos_BeginningEdit"
                CanFilterColumns="True"
                CanSortColumns="True"
                CellEditEnding="TablaCargos_CellEditEnding"
                IsReadOnly="False"
                PreparingCellForEdit="TablaCargos_PreparingCellForEdit"
                RowMinHeight="56"
                SelectionChanged="TablaCargos_SelectionChanged"
                SelectionMode="Single"
                SizeChanged="TablaCargos_SizeChanged">
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn
                        Width="110"
                        Binding="{Binding Tipo}"
                        Header="Tipo"
                        IsReadOnly="True" />
                    <tv:TableViewTemplateColumn
                        x:Name="ColumnaDetalle"
                        Width="250"
                        CanFilter="True"
                        ClipboardContentBinding="{Binding Detalle}"
                        Header="Detalle"
                        IsReadOnly="True"
                        SortMemberPath="Detalle">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:CargoFila">
                                <!--  Título (ej. "Kone") y debajo la descripción  -->
                                <StackPanel
                                    Padding="0,6"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Detalle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Detalle}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind Descripcion}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind Descripcion}"
                                        Visibility="{x:Bind TieneDescripcion}" />
                                </StackPanel>
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <!--
                        Editables con doble clic (Tag = campo): Cant., Unitario y Nota. El binding es
                        de una vía: el guardado lo hace TablaCargos_CellEditEnding.
                    -->
                    <tv:TableViewTextColumn
                        Width="80"
                        Binding="{Binding CantidadTexto, Mode=OneWay}"
                        Header="Cant."
                        SortMemberPath="Cantidad"
                        Tag="Cantidad" />
                    <tv:TableViewTextColumn
                        Width="120"
                        Binding="{Binding UnitarioTexto, Mode=OneWay}"
                        Header="Unitario"
                        SortMemberPath="Unitario"
                        Tag="Unitario" />
                    <tv:TableViewTextColumn
                        Width="120"
                        Binding="{Binding MontoTexto, Mode=OneWay}"
                        Header="Monto"
                        IsReadOnly="True"
                        SortMemberPath="Monto" />
                    <tv:TableViewTextColumn
                        Width="180"
                        Binding="{Binding Nota, Mode=OneWay}"
                        Header="Nota"
                        Tag="Nota" />
                    <tv:TableViewTextColumn
                        Width="150"
                        Binding="{Binding Proveedor}"
                        Header="Proveedor"
                        IsReadOnly="True" />
                </tv:TableView.Columns>
            </tv:TableView>
            <Grid x:Name="Info" Grid.Column="1">
                <!--  Galería de la operación: al seleccionar un cargo se desplaza a sus fotos  -->
                <Border
                    Margin="5"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Galería: mismos botones que la pestaña Documentos del visor  -->
                        <CommandBar 
                            x:Name="GaleriaAcciones"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            DefaultLabelPosition="Right">
                            <!--  Sin cargo seleccionado: agrega un cargo. Con un cargo: "Agregar fotos" a ese cargo (ver ActualizarBotonesCargo)  -->
                            <AppBarButton
                                x:Name="AgregarButton"
                                Click="AgregarButton_Click"
                                Icon="Add"
                                Label="Agregar"
                                ToolTipService.ToolTip="Agregar un cargo a la operación" />
                            <!--  Elimina el cargo seleccionado; solo aparece con un cargo seleccionado  -->
                            <AppBarButton
                                x:Name="EliminarButton"
                                Click="EliminarButton_Click"
                                Icon="Delete"
                                Label="Eliminar"
                                ToolTipService.ToolTip="Eliminar el cargo seleccionado"
                                Visibility="Collapsed" />
                            <!--  Solo con una refacción seleccionada  -->
                            <AppBarButton
                                x:Name="VerRefaccionButton"
                                Click="VerRefaccionButton_Click"
                                Icon="View"
                                Label="Ver refacción"
                                ToolTipService.ToolTip="Ver los datos de la refacción seleccionada"
                                Visibility="Collapsed" />
                            <!--  Generar, Cargar y Mtto Prev. son de la operación: se ocultan con un cargo seleccionado  -->
                            <AppBarButton
                                x:Name="GenerarButton"
                                Icon="Document"
                                Label="Generar"
                                ToolTipService.ToolTip="Generar y abrir documentos (cotización, reporte, nota, finiquito)">
                                <AppBarButton.Flyout>
                                    <MenuFlyout Opening="GenerarFlyout_Opening" Placement="Bottom">
                                        <MenuFlyoutItem
                                            Click="GenerarCotizacion_Click"
                                            Icon="Document"
                                            Text="Generar Cotización" />
                                        <MenuFlyoutItem
                                            x:Name="AbrirCotizacionItem"
                                            Click="AbrirCotizacionPdf_Click"
                                            Text="Abrir Cotización PDF">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontSize="14" Glyph="&#xEA90;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="GenerarReporte_Click"
                                            Icon="Document"
                                            Text="Generar Reporte" />
                                        <MenuFlyoutItem
                                            x:Name="AbrirReporteItem"
                                            Click="AbrirReportePdf_Click"
                                            Text="Abrir Reporte PDF">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontSize="14" Glyph="&#xEA90;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            x:Name="GenerarNotaItem"
                                            Click="GenerarNota_Click"
                                            Icon="Document"
                                            Text="Generar Nota"
                                            ToolTipService.ToolTip="Requiere trabajo finalizado" />
                                        <MenuFlyoutItem
                                            x:Name="AbrirNotaItem"
                                            Click="AbrirNotaPdf_Click"
                                            Text="Abrir Nota PDF">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontSize="14" Glyph="&#xEA90;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            x:Name="GenerarFiniquitoItem"
                                            Click="GenerarFiniquito_Click"
                                            Icon="MailForward"
                                            Text="Generar Finiquito"
                                            ToolTipService.ToolTip="Enviar por correo cotización, reporte y factura (requiere que la operación ya esté facturada)" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="CargarButton"
                                Icon="Attach"
                                Label="Cargar"
                                ToolTipService.ToolTip="Cargar documentos (prefactura, hoja de servicio, orden de compra, levantamiento)">
                                <AppBarButton.Flyout>
                                    <MenuFlyout Opening="CargarFlyout_Opening" Placement="Bottom">
                                        <MenuFlyoutItem
                                            x:Name="CargarPrefacturaItem"
                                            Click="CargarPrefactura_Click"
                                            Text="Cargar Prefactura" />
                                        <MenuFlyoutItem
                                            x:Name="CargarHojaServicioItem"
                                            Click="CargarHojaServicio_Click"
                                            Text="Cargar Hoja de Servicio" />
                                        <MenuFlyoutItem
                                            x:Name="CargarOrdenCompraItem"
                                            Click="CargarOrdenCompra_Click"
                                            Text="Cargar Orden de Compra" />
                                        <MenuFlyoutItem
                                            x:Name="CargarLevantamientoItem"
                                            Click="CargarLevantamiento_Click"
                                            Text="Cargar Levantamiento" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="MttoPrevButton"
                                Click="MttoPrev_Click"
                                Icon="Edit"
                                Label="Mtto Prev."
                                ToolTipService.ToolTip="Abrir formulario de mantenimiento preventivo" />
                        </CommandBar>
                        <TextBlock
                            x:Name="InfoTitulo"
                            Grid.Row="1"
                            FontWeight="SemiBold"
                            Text="Galería"
                            TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="GaleriaScroll" Grid.Row="2">
                            <StackPanel x:Name="GaleriaContenido" Spacing="8" />
                        </ScrollViewer>
                        <TextBlock
                            x:Name="InfoMensaje"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <ProgressRing
                            x:Name="InfoCargando"
                            Grid.Row="2"
                            IsActive="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid
            Grid.Row="2"
            Padding="10,6"
            Background="Transparent"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>


                <!--  Acciones de la operación  -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  Solo iconos; el tooltip dice qué hace cada uno (Reabrir, Finalizar y Aprobar lo cambian desde el código)  -->
                    <!--  Cotización abierta: cerrarla. Cerrada: registrar aprobación y reenviar notificación (ver ActualizarBotonesCotizacion)  -->

                    <Button
                        x:Name="FinalizarButton"
                        Height="32"
                        Click="FinalizarButton_Click">
                        <TextBlock x:Name="FinalizarText" Text="Finalizar" />
                    </Button>

                    <!--  Datos de la operación que no van en el encabezado, y el total de los cargos  -->
                    <!--  Nota de la operación (viene de la orden de servicio)  -->
                    <TextBlock
                        x:Name="NotaText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />
                    <!--  Operación abierta / finalizada  -->
                    <Border
                        x:Name="EstadoBadge"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        BorderThickness="1"
                        CornerRadius="10">
                        <TextBlock x:Name="EstadoBadgeText" FontSize="11" />
                    </Border>

                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <StackPanel
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Atiende:" />
                        <TextBlock x:Name="AtiendeText" Text="—" />
                    </StackPanel>
                    <StackPanel
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inicio:" />
                        <TextBlock x:Name="InicioText" Text="—" />
                    </StackPanel>
                    <StackPanel
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total:" />
                        <TextBlock
                            x:Name="TotalText"
                            FontWeight="SemiBold"
                            Text="$0.00" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  Línea de tiempo: pasos del check; debajo de cada paso cumplido, quién lo hizo  -->
            <Grid x:Name="LineaTiempo" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
