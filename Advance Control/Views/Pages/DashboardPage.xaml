<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                ══════════════════════════════════════════
                Hero: Bienvenida al usuario
                ══════════════════════════════════════════
            -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FechaHoy, Mode=OneWay}" />
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <Run Text="{x:Bind ViewModel.Saludo, Mode=OneWay}" />
                    <Run Text=", " />
                    <Run
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.NombreUsuario, Mode=OneWay}" />
                    <Run Text="." />
                </TextBlock>
            </StackPanel>

            <!--
                ══════════════════════════════════════════
                Separador
                ══════════════════════════════════════════
            -->
            <Border
                Grid.Row="1"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" />

            <!--
                ══════════════════════════════════════════
                Sección: Ops, pendientes por resolver, filtrado según el
                nivel del usuario (todo / solo su área / solo lo suyo).
                ══════════════════════════════════════════
            -->
            <StackPanel Grid.Row="3" Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowOps, Mode=OneWay}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Ops" />

                <Grid x:Name="Ops">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Card: operaciones abiertas (no t-Finalizado)  -->
                    <Grid x:Name="OpsAbiertasPendientes" Grid.Column="0">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsAbiertasPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE9F5;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Operaciones abiertas" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsAbiertasPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Card: t-Finalizado, todavía sin facturar  -->
                    <Grid x:Name="OpsTfinalizadoPendientes" Grid.Column="2">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsTFinalizadoPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Por facturar" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsTFinalizadoPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Card: facturadas, todavía sin cobrar  -->
                    <Grid x:Name="OpsFinalizadasPendientes" Grid.Column="4">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsFinalizadasPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE8C7;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Por cobrar" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsFinalizadasPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>

            <!--
                ══════════════════════════════════════════
                Sección: Noticias / Tareas / Alarmas (próximamente)
                ══════════════════════════════════════════
            -->
            <Pivot Grid.Row="5" Margin="-12,0,0,0">
                <PivotItem Header="Noticias">
                    <RichTextBlock
                        Margin="12,20,0,0"
                        MaxWidth="820"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        LineHeight="20">
                        <RichTextBlock.Blocks>

                            <Paragraph Margin="0,0,0,4">
                                <Run FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Novedades de las últimas semanas" />
                            </Paragraph>

                            <Paragraph Margin="0,12,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Suscripciones y contratos de mantenimiento" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Ya se pueden generar contratos de suscripción (Oro/Plata/Bronce) desde la ficha del cliente: se elige el nivel, se seleccionan los equipos cubiertos y se genera el PDF del contrato con su firma." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• A los clientes con un contrato de suscripción vigente ahora se les puede generar la factura mensual de iguala directamente desde la app." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se corrigió un error que impedía ver la lista de equipos disponibles al crear una suscripción nueva." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Facturación" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Ya es posible cancelar facturas (CFDI) directamente desde la app." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se agregó la carga del certificado necesario para poder cancelar facturas." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se corrigieron folios duplicados y problemas de numeración que afectaban a algunas facturas." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Operaciones" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nuevo Reporte General de Operaciones, con casillas de verificación por operación." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nuevo filtro para ver solo las operaciones abiertas que ya tienen orden de compra cargada." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Las operaciones con orden de compra, o con factura pagada/pendiente, ahora se distinguen con una barra de color en la lista." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se corrigió que las casillas de filtro por estado no actualizaban la lista de operaciones." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se corrigió un error que avisaba &quot;no se pudo guardar&quot; al subir fotos o documentos a una operación, aunque sí quedaban guardados." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Mantenimiento preventivo" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• El mantenimiento preventivo ahora queda registrado en el sistema, ya no se genera solo como PDF." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nuevo formulario para capturar y generar el reporte de mantenimiento preventivo." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Catálogos" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nuevo catálogo de Inmuebles." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se corrigió un error que mostraba &quot;no se pudo eliminar&quot; en Clientes, Entidades, Contactos, Operaciones, Órdenes de Servicio, Productos, Proveedores, Refacciones, Servicios, Cargos, Áreas y Ubicaciones, aunque el registro sí se había borrado." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Los campos de Régimen Fiscal y Uso de CFDI ahora sugieren valores mientras escribes." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Mapas" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Se corrigieron problemas al mostrar los mapas y ahora se avisa si falta información geográfica necesaria." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,2">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="En camino" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Estamos preparando las bases para un futuro Portal de Clientes, donde podrán consultar su información directamente." />
                            </Paragraph>

                        </RichTextBlock.Blocks>
                    </RichTextBlock>
                </PivotItem>
                <PivotItem Header="Tareas">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
                <PivotItem Header="Alarmas">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
            </Pivot>

        </Grid>
    </ScrollViewer>
</Page>
