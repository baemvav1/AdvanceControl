<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Advance_Control.Views.Formularios.MantenimientoPreventivoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Advance_Control.Views.Formularios"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>

            <Style x:Key="SeccionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="SeccionBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultSolid}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <!--
                Campo de solo texto (dato ya conocido de la operación, no editable): una
                etiqueta chica arriba y el valor abajo, sin marco de caja de texto, para que
                no parezca un input que el técnico podría llenar o modificar.
            -->
            <Style x:Key="CampoEstaticoEtiquetaStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CampoEstaticoValorStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  Fila de checklist de mantenimiento preventivo  -->
            <DataTemplate x:Key="ChecklistItemTemplate" x:DataType="local:ChecklistItem">
                <Grid
                    Padding="6,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Texto}"
                        TextWrapping="Wrap" />
                    <RadioButton
                        Grid.Column="1"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        GroupName="{x:Bind Id}"
                        IsChecked="{x:Bind NoAplica, Mode=TwoWay}" />
                    <RadioButton
                        Grid.Column="2"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        GroupName="{x:Bind Id}"
                        IsChecked="{x:Bind Verificacion, Mode=TwoWay}" />
                    <RadioButton
                        Grid.Column="3"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        GroupName="{x:Bind Id}"
                        IsChecked="{x:Bind Ajuste, Mode=TwoWay}" />
                    <RadioButton
                        Grid.Column="4"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        GroupName="{x:Bind Id}"
                        IsChecked="{x:Bind Limpieza, Mode=TwoWay}" />
                    <RadioButton
                        Grid.Column="5"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        GroupName="{x:Bind Id}"
                        IsChecked="{x:Bind Lubricacion, Mode=TwoWay}" />
                    <RadioButton
                        Grid.Column="6"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        GroupName="{x:Bind Id}"
                        IsChecked="{x:Bind Recorrido, Mode=TwoWay}" />
                </Grid>
            </DataTemplate>

            <!--  Encabezado de columnas para las tablas de mantenimiento preventivo (se repite por sección)  -->
            <DataTemplate x:Key="ChecklistHeaderTemplate">
                <Grid
                    Padding="6,6"
                    Background="{ThemeResource CardStrokeColorDefaultSolid}"
                    CornerRadius="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontWeight="SemiBold"
                        Text="Ítem" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="N/A"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="No aplica" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Verif."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Verificación" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Ajuste"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Ajuste" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Limp."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Limpieza" />
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Lubr."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Lubricación" />
                    <TextBlock
                        Grid.Column="6"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Recorr."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Recorrido" />
                </Grid>
            </DataTemplate>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Encabezado  -->
        <Grid
            Grid.Row="0"
            Padding="20,14"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Grid.Column="0" Symbol="Edit" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Mantenimiento Preventivo" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Formulario visual (aún no guarda información ni consulta datos)." />
                <TextBlock
                    x:Name="DirigidoATextBlock"
                    Grid.Row="2"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!--  Contenido  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <!--
                Columnas "*" a los lados: cuando el contenido central (Auto) entra en el
                viewport, se reparten el espacio sobrante y lo centran; cuando el viewport
                es más angosto que el contenido, colapsan a 0 y el ScrollViewer habilita el
                scroll horizontal. Esto se recalcula en cada Arrange (incluido maximizar),
                a diferencia de ScrollViewer.HorizontalContentAlignment, que no se
                re-centraba de forma confiable al maximizar.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="1"
                    MinWidth="960"
                    MaxWidth="1400"
                    Padding="20"
                    RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Expander
                        Grid.Row="0"
                        Header="Datos Generales"
                        IsExpanded="True"
                        Style="{StaticResource SeccionExpanderStyle}">
                        <Grid Padding="4,10" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource CampoEstaticoEtiquetaStyle}" Text="Nombre del cliente" />
                                    <TextBlock x:Name="NombreClienteTextBlock" Grid.Row="1" Style="{StaticResource CampoEstaticoValorStyle}" />
                                </Grid>
                                <Grid Grid.Column="1" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource CampoEstaticoEtiquetaStyle}" Text="Dirección" />
                                    <TextBlock x:Name="DireccionTextBlock" Grid.Row="1" Style="{StaticResource CampoEstaticoValorStyle}" />
                                </Grid>
                                <Grid Grid.Column="2" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource CampoEstaticoEtiquetaStyle}" Text="Equipo" />
                                    <TextBlock x:Name="EquipoTextBlock" Grid.Row="1" Style="{StaticResource CampoEstaticoValorStyle}" />
                                </Grid>
                                <Grid Grid.Column="3" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource CampoEstaticoEtiquetaStyle}" Text="Fecha" />
                                    <TextBlock x:Name="FechaTextBlock" Grid.Row="1" Style="{StaticResource CampoEstaticoValorStyle}" />
                                </Grid>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TimePicker
                                    x:Name="HoraEntradaTimePicker"
                                    Grid.Column="0"
                                    ClockIdentifier="24HourClock"
                                    Header="Hora de entrada" />
                                <TimePicker
                                    x:Name="HoraSalidaTimePicker"
                                    Grid.Column="1"
                                    ClockIdentifier="24HourClock"
                                    Header="Hora de salida" />
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Tipo de Máquina" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Usa las flechas o desliza para elegir; el que quede a la vista es el seleccionado." />
                                <FlipView
                                    x:Name="TipoMaquinaFlipView"
                                    Grid.Row="2"
                                    Width="380"
                                    Height="300"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SelectionChanged="TipoMaquinaFlipView_SelectionChanged">
                                    <FlipViewItem>
                                        <Grid
                                            Padding="16"
                                            HorizontalAlignment="Center"
                                            RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Height="220"
                                                Source="ms-appx:///Assets/Images/MttoPrevTipoHidraulico.jpg"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="Hidráulico"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </FlipViewItem>
                                    <FlipViewItem>
                                        <Grid
                                            Padding="16"
                                            HorizontalAlignment="Center"
                                            RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Height="220"
                                                Source="ms-appx:///Assets/Images/MttoPrevTipoConCuartoMaquinas.jpg"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="Con cuarto de máquinas"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </FlipViewItem>
                                    <FlipViewItem>
                                        <Grid
                                            Padding="16"
                                            HorizontalAlignment="Center"
                                            RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Height="220"
                                                Source="ms-appx:///Assets/Images/MttoPrevTipoSinCuartoMaquinas.jpg"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="Sin cuarto de máquinas (MRL)"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </FlipViewItem>
                                </FlipView>
                            </Grid>
                        </Grid>
                    </Expander>

                    <Expander
                        Grid.Row="1"
                        IsExpanded="True"
                        Style="{StaticResource SeccionExpanderStyle}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cabina" />
                                <Border Grid.Column="1" Style="{StaticResource SeccionBadgeStyle}">
                                    <TextBlock x:Name="CabinaProgresoTextBlock" FontSize="11" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <Grid Padding="0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Marcar toda la sección:" />
                                <Button
                                    Grid.Column="1"
                                    Click="MarcarSeccionButton_Click"
                                    Content="No aplica"
                                    Tag="Cabina:NoAplica" />
                                <Button
                                    Grid.Column="2"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Verificación"
                                    Tag="Cabina:Verificacion" />
                                <Button
                                    Grid.Column="3"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Limpiar"
                                    Tag="Cabina:Limpiar" />
                            </Grid>
                            <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ChecklistHeaderTemplate}" />
                            <ItemsRepeater Grid.Row="2" ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind CabinaChecklist}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="2" Style="{StaticResource SeccionExpanderStyle}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cuarto de Máquinas" />
                                <Border Grid.Column="1" Style="{StaticResource SeccionBadgeStyle}">
                                    <TextBlock x:Name="CuartoMaquinasProgresoTextBlock" FontSize="11" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <Grid Padding="0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Marcar toda la sección:" />
                                <Button
                                    Grid.Column="1"
                                    Click="MarcarSeccionButton_Click"
                                    Content="No aplica"
                                    Tag="CuartoMaquinas:NoAplica" />
                                <Button
                                    Grid.Column="2"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Verificación"
                                    Tag="CuartoMaquinas:Verificacion" />
                                <Button
                                    Grid.Column="3"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Limpiar"
                                    Tag="CuartoMaquinas:Limpiar" />
                            </Grid>
                            <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ChecklistHeaderTemplate}" />
                            <ItemsRepeater Grid.Row="2" ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind CuartoMaquinasChecklist}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="3" Style="{StaticResource SeccionExpanderStyle}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Foso" />
                                <Border Grid.Column="1" Style="{StaticResource SeccionBadgeStyle}">
                                    <TextBlock x:Name="FosoProgresoTextBlock" FontSize="11" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <Grid Padding="0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Marcar toda la sección:" />
                                <Button
                                    Grid.Column="1"
                                    Click="MarcarSeccionButton_Click"
                                    Content="No aplica"
                                    Tag="Foso:NoAplica" />
                                <Button
                                    Grid.Column="2"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Verificación"
                                    Tag="Foso:Verificacion" />
                                <Button
                                    Grid.Column="3"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Limpiar"
                                    Tag="Foso:Limpiar" />
                            </Grid>
                            <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ChecklistHeaderTemplate}" />
                            <ItemsRepeater Grid.Row="2" ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind FosoChecklist}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="4" Style="{StaticResource SeccionExpanderStyle}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pasillo" />
                                <Border Grid.Column="1" Style="{StaticResource SeccionBadgeStyle}">
                                    <TextBlock x:Name="PasilloProgresoTextBlock" FontSize="11" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <Grid Padding="0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Marcar toda la sección:" />
                                <Button
                                    Grid.Column="1"
                                    Click="MarcarSeccionButton_Click"
                                    Content="No aplica"
                                    Tag="Pasillo:NoAplica" />
                                <Button
                                    Grid.Column="2"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Verificación"
                                    Tag="Pasillo:Verificacion" />
                                <Button
                                    Grid.Column="3"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Limpiar"
                                    Tag="Pasillo:Limpiar" />
                            </Grid>
                            <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ChecklistHeaderTemplate}" />
                            <ItemsRepeater Grid.Row="2" ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind PasilloChecklist}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="5" Style="{StaticResource SeccionExpanderStyle}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Techo de Cabina" />
                                <Border Grid.Column="1" Style="{StaticResource SeccionBadgeStyle}">
                                    <TextBlock x:Name="TechoCabinaProgresoTextBlock" FontSize="11" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <Grid Padding="0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Marcar toda la sección:" />
                                <Button
                                    Grid.Column="1"
                                    Click="MarcarSeccionButton_Click"
                                    Content="No aplica"
                                    Tag="TechoCabina:NoAplica" />
                                <Button
                                    Grid.Column="2"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Verificación"
                                    Tag="TechoCabina:Verificacion" />
                                <Button
                                    Grid.Column="3"
                                    Click="MarcarSeccionButton_Click"
                                    Content="Limpiar"
                                    Tag="TechoCabina:Limpiar" />
                            </Grid>
                            <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ChecklistHeaderTemplate}" />
                            <ItemsRepeater Grid.Row="2" ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind TechoCabinaChecklist}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Expander>

                    <Expander
                        Grid.Row="6"
                        Header="Evidencia Fotográfica"
                        Style="{StaticResource SeccionExpanderStyle}">
                        <StackPanel Padding="4,10" Spacing="10">
                            <Border
                                Padding="20"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid HorizontalAlignment="Center" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <SymbolIcon Grid.Row="0" HorizontalAlignment="Center" Symbol="Camera" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Arrastra imágenes aquí o usa el botón para agregar evidencia" />
                                    <Button Grid.Row="2" HorizontalAlignment="Center" Content="Agregar fotografía" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Grid.Row="7"
                        Header="Resumen de Asistencia y Observaciones"
                        Style="{StaticResource SeccionExpanderStyle}">
                        <Grid Padding="4,10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="ObservacionesTextBox"
                                Grid.Row="0"
                                Height="110"
                                AcceptsReturn="True"
                                Header="Resumen de asistencia, material, irregularidades de seguridad o comentarios"
                                TextWrapping="Wrap" />
                            <Grid
                                Grid.Row="1"
                                Margin="0,0,12,12"
                                RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Situación final del equipo" />
                                <Grid
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        x:Name="SituacionOperativoRadioButton"
                                        Grid.Column="0"
                                        Content="Operativo"
                                        GroupName="rbGroup41" />
                                    <RadioButton
                                        x:Name="SituacionDetenidoRadioButton"
                                        Grid.Column="1"
                                        Content="Detenido"
                                        GroupName="rbGroup41" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <Expander
                        Grid.Row="8"
                        Header="Confirmaciones"
                        Style="{StaticResource SeccionExpanderStyle}">
                        <Grid Padding="4,10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Firmas" />
                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Name="TecnicoNombreTextBlock"
                                        Grid.Row="0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border
                                        Grid.Row="1"
                                        Height="90"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <TextBlock
                                                x:Name="FirmaTecnicoPlaceholder"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="Firma del técnico" />
                                            <Image
                                                x:Name="FirmaTecnicoImage"
                                                Margin="8"
                                                Stretch="Uniform"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="1" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Firma del cliente" />
                                    <Border
                                        Grid.Row="1"
                                        Height="90"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="Firma del cliente" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!--  Pie de ventana  -->
        <Grid
            Grid.Row="2"
            Padding="20,12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid HorizontalAlignment="Right" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="EstadoFinalizarTextBlock"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontStyle="Italic"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Los checklists y observaciones no se guardan hasta presionar Finalizar." />
                <Button Grid.Column="1" Click="CerrarButton_Click" Content="Cerrar" />
                <Button
                    x:Name="FinalizarButton"
                    Grid.Column="2"
                    Click="FinalizarButton_Click"
                    Content="Finalizar"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
