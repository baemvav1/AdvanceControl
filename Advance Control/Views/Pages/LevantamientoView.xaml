                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCubo_Ajuste"
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCubo_Limpieza"
