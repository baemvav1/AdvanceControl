                                        Grid.Row="6"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Extintor en cuarto de máquinas  -->
                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Extintor en cuarto de máquinas" />
                                    </Border>
