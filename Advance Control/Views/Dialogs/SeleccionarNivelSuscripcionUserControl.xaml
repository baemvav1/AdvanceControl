<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Advance_Control.Views.Dialogs.SeleccionarNivelSuscripcionUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="360">

    <StackPanel Spacing="4">
        <TextBlock
            Margin="0,0,0,8"
            FontWeight="SemiBold"
            Text="Seleccione el nivel del contrato de suscripción:" />

        <RadioButton
            x:Name="OroRadio"
            Content="Oro"
            GroupName="NivelSuscripcionGroup"
            Checked="NivelRadio_Checked"
            Tag="Oro" />
        <RadioButton
            x:Name="PlataRadio"
            Content="Plata"
            GroupName="NivelSuscripcionGroup"
            Checked="NivelRadio_Checked"
            Tag="Plata" />
        <RadioButton
            x:Name="BronceRadio"
            Content="Bronce"
            GroupName="NivelSuscripcionGroup"
            Checked="NivelRadio_Checked"
            Tag="Bronce" />
    </StackPanel>
</UserControl>
