                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCuartoMaq_Ajuste"
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCuartoMaq_Limpieza"
                                        Grid.Row="4"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCuartoMaq_Lubricacion"
                                        Grid.Row="4"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Iluminación en cubo  -->
                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Iluminación en cubo" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCubo_NoAplica"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCubo_Verificacion"
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCubo_Ajuste"
                                        Grid.Row="5"
                                        Grid.Column="3"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCubo_Limpieza"
                                        Grid.Row="5"
                                        Grid.Column="4"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCubo_Lubricacion"
                                        Grid.Row="5"
                                        Grid.Column="5"
                                        Style="{StaticResource ItemCheckBoxStyle}" />

                                    <!--  Iluminación en cuarto de máquinas  -->
                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource ItemRowBorderStyle}">
                                        <TextBlock Style="{StaticResource ItemTextStyle}" Text="Iluminación en cuarto de máquinas" />
                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCuartoMaq_NoAplica"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_IluminacionCuartoMaq_Verificacion"
