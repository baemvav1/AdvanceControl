<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Advance_Control.Views.Pages.VisorMundialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Advance_Control.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="20,16,20,8"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Visor Mundial" />

            <ComboBox
                x:Name="ModoColoreoComboBox"
                Header="Colorear pines por"
                SelectedIndex="0"
                SelectionChanged="ModoColoreoComboBox_SelectionChanged">
                <ComboBoxItem Content="Estado de operaciones" Tag="operaciones" />
                <ComboBoxItem Content="Estado de cobranza" Tag="cobranza" />
            </ComboBox>

            <Button
                x:Name="BtnActualizar"
                VerticalAlignment="Bottom"
                Click="BtnActualizar_Click"
                Content="Actualizar"
                IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />

            <Button
                x:Name="BtnTogglePanel"
                VerticalAlignment="Bottom"
                Click="BtnTogglePanel_Click"
                Content="Mostrar/ocultar panel" />
        </StackPanel>

        <StackPanel Grid.Row="1" Padding="20,0,20,8">
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ResumenUbicaciones, Mode=OneWay}" />
        </StackPanel>

        <SplitView
            x:Name="PanelSplitView"
            Grid.Row="2"
            DisplayMode="Inline"
            IsPaneOpen="{x:Bind ViewModel.IsPanelOpen, Mode=OneWay}"
            OpenPaneLength="380"
            PanePlacement="Right">
            <SplitView.Pane>
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Panel del director" />

                    <Pivot Grid.Row="1">
                        <PivotItem Header="Ubicación">
                            <ScrollViewer>
                                <StackPanel Padding="4" Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Selecciona un pin en el mapa para ver el detalle."
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind ViewModel.NoHayUbicacionSeleccionada, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasUbicacionSeleccionada, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UbicacionSeleccionada.Nombre, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.UbicacionSeleccionada.DireccionCompleta, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        IsActive="{x:Bind ViewModel.IsLoadingDetalle, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLoadingDetalle, Mode=OneWay}" />

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.EquiposUbicacionSeleccionada, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:VisorMundialEquipoDto">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="10"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Identificador}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Marca}" />
                                                        <TextBlock Text="{Binding ClientesTexto}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock Text="{Binding EstadoTexto}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </PivotItem>

                        <PivotItem Header="Clientes">
                            <ListView ItemsSource="{x:Bind ViewModel.Clientes, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerDto">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding RazonSocial}" TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Rfc}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </PivotItem>

                        <PivotItem Header="Equipos">
                            <ListView ItemsSource="{x:Bind ViewModel.Equipos, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EquipoDto">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Identificador}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Marca}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </PivotItem>

                        <PivotItem Header="Técnicos">
                            <ListView ItemsSource="{x:Bind ViewModel.Tecnicos, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ContactoDto">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding NombreCompleto}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Cargo}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </PivotItem>

                        <PivotItem Header="Cobranza">
                            <ScrollViewer>
                                <StackPanel Padding="4" Spacing="10">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Resumen global" />
                                            <TextBlock Text="{x:Bind ViewModel.TotalFacturadoGlobalTexto, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.TotalAbonadoGlobalTexto, Mode=OneWay}" />
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalPendienteGlobalTexto, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock FontWeight="SemiBold" Text="Clientes con mayor saldo pendiente" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopClientesSaldo, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ReporteFinancieroFacturacionCabeceraDto">
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding ReceptorNombreTexto}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock Text="{Binding TotalFacturadoTexto}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </SplitView.Pane>

            <Grid>
                <WebView2 x:Name="MapWebView" Visibility="{x:Bind ViewModel.IsMapInitialized, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ProgressRing
                    Width="48"
                    Height="48"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>
        </SplitView>
    </Grid>
</Page>
