<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Advance_Control.Views.Dialogs.CancelarCfdiDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Cancelar CFDI ante el SAT"
    PrimaryButtonText="Cancelar factura"
    CloseButtonText="Regresar"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="480" Spacing="12">
        <TextBlock
            x:Name="ResumenFacturaTextBlock"
            FontWeight="SemiBold"
            TextWrapping="WrapWholeWords" />

        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Severity="Warning"
            Message="Esta operación es irreversible y no existe ambiente de pruebas: se ejecuta directamente contra el SAT. Consume 1 timbre si Bilkon confirma la cancelación." />

        <TextBlock Text="Motivo de cancelación" />
        <ComboBox
            x:Name="MotivoComboBox"
            HorizontalAlignment="Stretch"
            SelectionChanged="MotivoComboBox_SelectionChanged">
            <ComboBoxItem Content="01 · Comprobante emitido con errores con relación" Tag="01" />
            <ComboBoxItem Content="02 · Comprobante emitido con errores sin relación" Tag="02" />
            <ComboBoxItem Content="03 · No se llevó a cabo la operación" Tag="03" />
            <ComboBoxItem Content="04 · Operación nominativa relacionada en una factura global" Tag="04" />
        </ComboBox>

        <StackPanel x:Name="SustitucionPanel" Spacing="4" Visibility="Collapsed">
            <AutoSuggestBox
                x:Name="SustitucionAutoSuggestBox"
                Header="Factura que sustituye (obligatorio para motivo 01)"
                PlaceholderText="Buscar por receptor, UUID o folio…"
                QueryIcon="Find"
                SuggestionChosen="SustitucionAutoSuggestBox_SuggestionChosen"
                TextChanged="SustitucionAutoSuggestBox_TextChanged" />
        </StackPanel>

        <CheckBox
            x:Name="ConfirmacionCheckBox"
            Content="Entiendo que esta cancelación es irreversible y no se puede deshacer." />

        <InfoBar
            x:Name="EstadoInfoBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
    </StackPanel>
</ContentDialog>
