<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Advance_Control.Views.Dialogs.ImportacionAutomaticaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Importación automática"
    PrimaryButtonText="Importar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="480" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Descarga del portal FEL en Línea todas las facturas del mes: integra las que no estén en el sistema, omite las que ya existen y aplica las cancelaciones que se hayan hecho en el portal."
            TextWrapping="WrapWholeWords" />

        <DatePicker
            x:Name="MesDatePicker"
            Header="Mes"
            HorizontalAlignment="Stretch"
            DayVisible="False" />

        <TextBox x:Name="UsuarioTextBox" Header="Usuario" />
        <TextBox x:Name="CuentaTextBox" Header="Cuenta" />
        <PasswordBox x:Name="PasswordBox" Header="Contraseña" />

        <InfoBar
            x:Name="EstadoInfoBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
    </StackPanel>
</ContentDialog>
