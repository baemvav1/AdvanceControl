<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.FacturasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Pestañas: la auditoría de Complementos de Pago antes era otra entrada del menú  -->
        <SelectorBar
            x:Name="PestanasSelectorBar"
            Grid.Row="0"
            Margin="12,8,12,0"
            SelectionChanged="PestanasSelectorBar_SelectionChanged">
            <SelectorBarItem
                x:Name="PestanaFacturas"
                IsSelected="True"
                Text="Facturas" />
            <SelectorBarItem x:Name="PestanaComplementos" Text="Complementos de pago" />
        </SelectorBar>

        <!--  Se llena al abrir la pestaña por primera vez con ComplementosPagoAuditoriaPage  -->
        <Frame
            x:Name="ComplementosFrame"
            Grid.Row="1"
            Visibility="Collapsed" />

        <Grid
            x:Name="FacturasContenido"
            Grid.Row="1"
            Padding="20"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Encabezado: buscador + filtros  -->
            <Border
                Grid.Row="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Facturas CFDI" />
                        <!--  El texto se busca solo en el campo elegido; la selección inicial se pone en el constructor  -->
                        <ComboBox
                            x:Name="CampoBusquedaComboBox"
                            Width="170"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Campo en el que se busca el texto">
                            <ComboBoxItem Content="RFC" Tag="Rfc" />
                            <ComboBoxItem Content="Nombre comercial" Tag="NombreComercial" />
                            <ComboBoxItem Content="Serie + folio" Tag="Folio" />
                        </ComboBox>
                        <AutoSuggestBox
                            x:Name="BusquedaAutoSuggestBox"
                            Width="320"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.Sugerencias, Mode=OneWay}"
                            QueryIcon="Find"
                            QuerySubmitted="BusquedaAutoSuggestBox_QuerySubmitted"
                            TextChanged="BusquedaAutoSuggestBox_TextChanged" />
                        <!--  Nuevo: clic directo; la flecha abre las cargas de facturas ya timbradas  -->
                        <SplitButton
                            Click="BtnNuevaFactura_Click"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            ToolTipService.ToolTip="Hacer y timbrar una factura desde cero para un cliente registrado">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Nuevo" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Opening="MenuCargas_Opening" Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem
                                        Click="BtnCargarFacturaXml_Click"
                                        Text="Cargar XML"
                                        ToolTipService.ToolTip="Cargar una factura ya timbrada en el sistema web del proveedor (folio suelto, sin serie)">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="OpenFile" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Click="BtnCargarMultiplesFacturas_Click"
                                        Text="Subir varios XML"
                                        ToolTipService.ToolTip="Cargar en lote varias facturas ya timbradas en el sistema web del proveedor">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Upload" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="BtnImportacionAutomatica_Click"
                                        Text="Importación automática"
                                        ToolTipService.ToolTip="Descarga un mes completo del portal FEL en Línea: integra las facturas que falten, omite las existentes y aplica las cancelaciones hechas en el portal">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Sync" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>
                    <!--  Renglón de filtros en una sola barra: fechas, tipo de CFDI, Buscar y Limpiar  -->
                    <CommandBar
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="False"
                        OverflowButtonVisibility="Collapsed">
                        <AppBarElementContainer VerticalContentAlignment="Center">
                            <CalendarDatePicker
                                x:Name="FechaDesdeDatePicker"
                                Width="170"
                                Margin="0,0,8,0"
                                Date="{x:Bind ViewModel.FechaDesde, Mode=TwoWay}"
                                PlaceholderText="Desde"
                                ToolTipService.ToolTip="Fecha inicial" />
                        </AppBarElementContainer>
                        <AppBarElementContainer VerticalContentAlignment="Center">
                            <CalendarDatePicker
                                x:Name="FechaHastaDatePicker"
                                Width="170"
                                Date="{x:Bind ViewModel.FechaHasta, Mode=TwoWay}"
                                PlaceholderText="Hasta"
                                ToolTipService.ToolTip="Fecha final" />
                        </AppBarElementContainer>
                        <AppBarSeparator />
                        <!--  Tipos de CFDI a mostrar: cada botón se prende/apaga y filtra al momento  -->
                        <AppBarToggleButton
                            Click="FiltroTipo_Click"
                            IsChecked="{x:Bind ViewModel.IncluirConSerie, Mode=TwoWay}"
                            Label="Serie + folio"
                            ToolTipService.ToolTip="Facturas generadas por el software (Serie A + folio propio)">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            Click="FiltroTipo_Click"
                            IsChecked="{x:Bind ViewModel.IncluirSinSerie, Mode=TwoWay}"
                            Label="Sin serie"
                            ToolTipService.ToolTip="Facturas emitidas manualmente desde el portal de Bilkon, identificadas solo por folio">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE7C3;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            Click="FiltroTipo_Click"
                            IsChecked="{x:Bind ViewModel.IncluirComplementosPago, Mode=TwoWay}"
                            Label="Complementos"
                            ToolTipService.ToolTip="Complementos de pago (CFDI de tipo Pago)">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8C7;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarSeparator />
                        <AppBarButton
                            x:Name="BtnBuscar"
                            Click="BtnBuscar_Click"
                            Icon="Find"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Label="Buscar" />
                        <AppBarButton
                            x:Name="BtnLimpiarFiltros"
                            Click="BtnLimpiarFiltros_Click"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Label="Limpiar filtros">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE894;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>




                </Grid>
            </Border>

            <!--  Estado: cargando / mensajes  -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ProgressRing
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <StackPanel Grid.Column="1">
                    <InfoBar
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error" />

                    <InfoBar
                        Margin="0,8,0,0"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                        Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                        Severity="Success" />
                </StackPanel>
            </Grid>

            <!--  Listado de facturas  -->
            <Grid Grid.Row="2">
                <ListView
                    x:Name="FacturasListView"
                    Padding="0,0,4,0"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.FacturasPagina, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FacturaResumenDto">
                            <Border
                                Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Información principal  -->
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Text="{Binding FolioTitulo}" />

                                            <Border
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <TextBlock FontSize="11" Text="{Binding TipoFacturaTexto}" />
                                            </Border>

                                            <Border
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <TextBlock FontSize="11" Text="{Binding EstadoPagoTexto}" />
                                            </Border>

                                            <Border
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding Cancelada, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock FontSize="11" Text="{Binding EstadoCancelacionTexto}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding ReceptorNombre}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding RfcTexto}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding FechaTexto}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding UuidTexto}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <!--  Total + acciones  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="10">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Text="{Binding TotalTexto}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SaldoPendienteTexto}" />

                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Click="BtnDescargarPdf_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Descargar PDF">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                                    <TextBlock Text="PDF" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="BtnDescargarXml_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Descargar XML">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                                    <TextBlock Text="XML" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="BtnComplementoPago_Click"
                                                IsEnabled="{Binding PuedeCapturarPagoManual}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding TooltipCapturarPagoTexto}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                    <TextBlock Text="Registrar abono" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="BtnGenerarComplementoPago_Click"
                                                IsEnabled="{Binding PuedeGenerarComplementoPago}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding TooltipGenerarComplementoTexto}"
                                                Visibility="{Binding PuedeGenerarComplementoPago, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE9F5;" />
                                                    <TextBlock Text="Generar complemento de pago" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="BtnCancelar_Click"
                                                IsEnabled="{Binding PuedeCancelarCfdi}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding TooltipCancelarTexto}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                                    <TextBlock Text="Cancelar" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="BtnComprobanteCancelacion_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Descargar acuse de cancelación (SAT)"
                                                Visibility="{Binding Cancelada, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                                    <TextBlock Text="Acuse" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="BtnAbrir_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Abrir detalle de la factura">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                                    <TextBlock Text="Abrir" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.SinResultados, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ResumenPaginacionTexto, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--  Footer: paginación y totales  -->
            <Border
                Grid.Row="3"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ResumenPaginacionTexto, Mode=OneWay}" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Click="BtnPaginaAnterior_Click"
                            Content="◀ Anterior"
                            IsEnabled="{x:Bind ViewModel.PuedeIrAnterior, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PaginaTexto, Mode=OneWay}" />
                        <Button
                            Click="BtnPaginaSiguiente_Click"
                            Content="Siguiente ▶"
                            IsEnabled="{x:Bind ViewModel.PuedeIrSiguiente, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
