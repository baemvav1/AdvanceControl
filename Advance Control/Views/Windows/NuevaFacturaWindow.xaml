<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Advance_Control.Views.Windows.NuevaFacturaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <SymbolIcon Symbol="Document" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Nueva factura" />
                <TextBlock
                    x:Name="TxtSubtitulo"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="CFDI 4.0 de ingreso" />
            </StackPanel>

            <TextBlock
                x:Name="TxtMonto"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource SystemAccentColor}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="16">

                <!--  Emisor (solo lectura)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Emisor" />
                            <ProgressRing
                                x:Name="EmisorProgressRing"
                                Width="18"
                                Height="18"
                                Margin="4,4,0,0"
                                IsActive="False" />
                        </StackPanel>

                        <InfoBar
                            x:Name="EmisorInfoBar"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning" />

                        <TextBlock
                            x:Name="TxtEmisorResumen"
                            Grid.Row="2"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </Border>

                <!--  Receptor: solo clientes registrados  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Cliente (receptor)" />
                            <ProgressRing
                                x:Name="ClientesProgressRing"
                                Width="18"
                                Height="18"
                                Margin="4,4,0,0"
                                IsActive="False" />
                        </StackPanel>

                        <AutoSuggestBox
                            x:Name="ClienteAutoSuggestBox"
                            Grid.Row="1"
                            PlaceholderText="Buscar cliente registrado por razón social, nombre comercial o RFC…"
                            QueryIcon="Find"
                            QuerySubmitted="ClienteAutoSuggestBox_QuerySubmitted"
                            SuggestionChosen="ClienteAutoSuggestBox_SuggestionChosen"
                            TextChanged="ClienteAutoSuggestBox_TextChanged" />

                        <InfoBar
                            x:Name="ReceptorInfoBar"
                            Grid.Row="2"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning" />

                        <Grid
                            x:Name="ReceptorDatosGrid"
                            Grid.Row="3"
                            ColumnSpacing="16"
                            RowSpacing="8"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="RFC:" />
                                <TextBlock x:Name="TxtReceptorRfc" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Razón social:" />
                                <TextBlock x:Name="TxtReceptorRazonSocial" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Código postal fiscal:" />
                                <TextBlock x:Name="TxtReceptorCodigoPostal" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Régimen fiscal:" />
                                <TextBlock x:Name="TxtReceptorRegimenFiscal" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Uso de CFDI:" />
                                <ComboBox
                                    x:Name="CmbReceptorUsoCfdi"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Selecciona un uso de CFDI" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Forma de pago  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}" Text="Forma de pago" />

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Método de pago:" />
                                <ComboBox
                                    x:Name="CmbMetodoPago"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="CmbMetodoPago_SelectionChanged">
                                    <ComboBoxItem Content="PUE - Pago en una sola exhibición" Tag="PUE" />
                                    <ComboBoxItem Content="PPD - Pago en parcialidades o diferido" Tag="PPD" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Forma de pago:" />
                                <ComboBox x:Name="CmbFormaPago" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="01 - Efectivo" Tag="01" />
                                    <ComboBoxItem Content="02 - Cheque nominativo" Tag="02" />
                                    <ComboBoxItem Content="03 - Transferencia electrónica de fondos" Tag="03" />
                                    <ComboBoxItem Content="04 - Tarjeta de crédito" Tag="04" />
                                    <ComboBoxItem Content="05 - Monedero electrónico" Tag="05" />
                                    <ComboBoxItem Content="06 - Dinero electrónico" Tag="06" />
                                    <ComboBoxItem Content="08 - Vales de despensa" Tag="08" />
                                    <ComboBoxItem Content="28 - Tarjeta de débito" Tag="28" />
                                    <ComboBoxItem Content="29 - Tarjeta de servicios" Tag="29" />
                                    <ComboBoxItem Content="30 - Aplicación de anticipos" Tag="30" />
                                    <ComboBoxItem Content="99 - Por definir" Tag="99" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Moneda:" />
                                <TextBlock VerticalAlignment="Center" Text="MXN - Peso mexicano" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Condiciones de pago (opcional):" />
                            <TextBox x:Name="TxtCondicionesDePago" PlaceholderText="Ej. 30 días" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Conceptos (captura libre)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Conceptos" />
                            <Button
                                x:Name="BtnAgregarConcepto"
                                Grid.Column="1"
                                Click="BtnAgregarConcepto_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="Agregar concepto" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <InfoBar
                            x:Name="ConceptosInfoBar"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning" />

                        <StackPanel
                            x:Name="ConceptosListPanel"
                            Grid.Row="2"
                            Spacing="10" />
                    </Grid>
                </Border>

                <!--  Total  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}" Text="Total" />

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            Spacing="4">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock Text="Subtotal:" />
                                <TextBlock
                                    x:Name="TxtSubtotal"
                                    MinWidth="110"
                                    TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock Text="IVA:" />
                                <TextBlock
                                    x:Name="TxtIva"
                                    MinWidth="110"
                                    TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Total:" />
                                <TextBlock
                                    x:Name="TxtTotalGeneral"
                                    MinWidth="110"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    TextAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Emitir  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}" Text="Emitir CFDI" />

                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Se asignará automáticamente la Serie A con el siguiente folio consecutivo. Timbrar consume un timbre y el CFDI queda registrado ante el SAT."
                            TextWrapping="WrapWholeWords" />

                        <InfoBar
                            x:Name="EmisionInfoBar"
                            Grid.Row="2"
                            IsClosable="False"
                            IsOpen="False" />

                        <StackPanel
                            Grid.Row="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12">
                            <ProgressRing
                                x:Name="EmisionProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False" />
                            <Button
                                x:Name="BtnCerrar"
                                Click="BtnCerrar_Click"
                                Content="Cerrar" />
                            <Button
                                x:Name="BtnTimbrar"
                                Click="BtnTimbrar_Click"
                                Content="Timbrar"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
