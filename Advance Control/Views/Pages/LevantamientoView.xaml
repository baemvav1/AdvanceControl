                                    </Border>
                                    <CheckBox
                                        x:Name="Cbx_Otros_AguaCubo_NoAplica"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
