<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.ProCatalogosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Advance_Control.Views.Controls"
    xmlns:converters="using:Advance_Control.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="EtiquetaFicha" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ValorFicha" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="Red">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Background="Purple" x:Name="Equipos">

            <!--  Vacío: botón "+" que abre el buscador de equipos  -->
            <Button
                Width="56"
                Height="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="AgregarEquipo_Click"
                CornerRadius="28"
                Style="{ThemeResource AccentButtonStyle}"
                ToolTipService.ToolTip="Buscar equipo"
                Visibility="{x:Bind ViewModel.SinEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon FontSize="20" Glyph="&#xE710;" />
            </Button>

            <!--  Con equipo: tarjeta + basura para limpiarla  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="TarjetaEquipo_Tapped"
                Visibility="{x:Bind ViewModel.HayEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel Margin="0,0,40,0" Spacing="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="EQUIPO" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="28"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Equipo.Identificador, Mode=OneWay}" />
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Equipo.MarcaTexto, Mode=OneWay}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Equipo.CapacidadTexto, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Spacing="4">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE707;" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Equipo.UbicacionAreaTexto, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="LimpiarEquipo_Click"
                        ToolTipService.ToolTip="Quitar equipo">
                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Background="Green" x:Name="Clientes">

            <!--  Sin equipo: nada que mostrar  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Text="Elige un equipo"
                Visibility="{x:Bind ViewModel.SinEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!--  Tarjeta: clientes vinculados al equipo, + para vincular y basura para desvincular el seleccionado  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HayEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="CLIENTES" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Click="AgregarCliente_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Vincular cliente">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                Click="DesvincularCliente_Click"
                                IsEnabled="{x:Bind ViewModel.HayClienteSeleccionado, Mode=OneWay}"
                                ToolTipService.ToolTip="Desvincular cliente seleccionado">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Clientes}"
                            SelectedItem="{x:Bind ViewModel.ClienteSeleccionado, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RelacionClienteDto">
                                    <TextBlock
                                        Padding="0,6"
                                        Text="{x:Bind RazonSocial}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ProgressRing
                            Width="24"
                            Height="24"
                            IsActive="{x:Bind ViewModel.CargandoClientes, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sin clientes vinculados. Usa + para vincular uno."
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.SinClientes, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1" Background="Blue" x:Name="Areas">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Text="Elige un equipo"
                Visibility="{x:Bind ViewModel.SinEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!--  Tarjeta de área: buscar o crear (sin basura); bloqueada si el equipo ya tiene ubicación  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="TarjetaArea_Tapped"
                Visibility="{x:Bind ViewModel.HayEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="ÁREA" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.AreaEditable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button Click="BuscarArea_Click" ToolTipService.ToolTip="Buscar área">
                                <FontIcon FontSize="14" Glyph="&#xE721;" />
                            </Button>
                            <Button
                                Click="CrearArea_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Crear área">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                        <FontIcon
                            HorizontalAlignment="Right"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;"
                            ToolTipService.ToolTip="El equipo ya tiene ubicación: el área no se puede cambiar"
                            Visibility="{x:Bind ViewModel.AreaBloqueada, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.AreaTexto, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="1" Background="Pink" x:Name="Ubicaciones">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Text="Elige un equipo"
                Visibility="{x:Bind ViewModel.SinEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!--  Bloqueada hasta que haya área  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.UbicacionBloqueada, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Primero elige un área" />
                </StackPanel>
            </Border>

            <!--  Tarjeta de ubicación: buscar o crear dentro del área; se asigna al equipo en el momento  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="TarjetaUbicacion_Tapped"
                Visibility="{x:Bind ViewModel.UbicacionHabilitada, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="UBICACIÓN" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button Click="BuscarUbicacion_Click" ToolTipService.ToolTip="Buscar ubicación del área">
                                <FontIcon FontSize="14" Glyph="&#xE721;" />
                            </Button>
                            <Button
                                Click="CrearUbicacion_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Crear ubicación">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.UbicacionNombre, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.UbicacionDireccion, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Column="2" Grid.RowSpan="2" Background="DarkGray" x:Name="Visor">

            <!--  Mapa: desplegado desde el inicio; equipo y cliente se muestran encima  -->
            <controls:MapaVisorControl
                x:Name="Mapa"
                GeoClic="Mapa_GeoClic"
                MarcadorClic="Mapa_MarcadorClic"
                PuntoClic="Mapa_PuntoClic" />

            <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{x:Bind ViewModel.VisorTapaMapa, Mode=OneWay, Converter={StaticResource BoolToVis}}">

            <!--  Equipo: resumen de operaciones (fase 4)  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.VisorEquipo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="RESUMEN DE OPERACIONES" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Equipo.Identificador, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente: totales (facturado y vencido), últimas operaciones, última visita y órdenes pendientes."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Cliente: ficha completa + contactos  -->
            <Border
                Margin="12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.VisorCliente, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Cabecera: todos los datos del cliente  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="CLIENTE" />
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ClienteRazonSocial, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Nombre comercial" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteNombreComercial, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="RFC" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteRfc, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Estatus" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteEstatus, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Régimen fiscal" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteRegimen, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Uso de CFDI" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteUsoCfdi, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Código postal" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteCodigoPostal, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Días de crédito" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteDiasCredito, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Límite de crédito" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteLimiteCredito, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Prioridad" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClientePrioridad, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource EtiquetaFicha}" Text="Notas" />
                                <TextBlock Style="{StaticResource ValorFicha}" Text="{x:Bind ViewModel.ClienteNotas, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  Contactos: + para vincular, basura para desvincular el seleccionado  -->
                    <Grid Grid.Row="1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="CONTACTOS" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Click="AgregarContacto_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Vincular contacto">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                Click="DesvincularContacto_Click"
                                IsEnabled="{x:Bind ViewModel.HayContactoSeleccionado, Mode=OneWay}"
                                ToolTipService.ToolTip="Desvincular contacto seleccionado">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView
                            IsItemClickEnabled="True"
                            ItemClick="Contacto_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Contactos}"
                            SelectedItem="{x:Bind ViewModel.ContactoSeleccionado, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ContactoDto">
                                    <TextBlock Padding="0,6" Text="{x:Bind NombreCorto}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ProgressRing
                            Width="24"
                            Height="24"
                            IsActive="{x:Bind ViewModel.CargandoCliente, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sin contactos. Usa + para vincular uno."
                            Visibility="{x:Bind ViewModel.SinContactos, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
            </Grid>

            <!--  Crear área: se elige un estado o municipio en el mapa  -->
            <Border
                Width="320"
                Margin="12"
                Padding="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.VisorCrearArea, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Nueva área" />
                    <TextBlock
                        x:Name="GeoElegidoText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Elige un estado o municipio en el mapa."
                        TextWrapping="Wrap" />
                    <TextBox x:Name="NombreAreaTextBox" Header="Nombre del área *" />
                    <TextBlock
                        x:Name="ErrorAreaText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="GuardarAreaButton"
                            MinWidth="100"
                            Click="GuardarArea_Click"
                            Content="Guardar"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button
                            MinWidth="100"
                            Click="CancelarCreacion_Click"
                            Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Crear ubicación: dirección buscada + punto ajustado en el mapa; todo obligatorio  -->
            <Border
                Width="340"
                Margin="12"
                Padding="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.VisorCrearUbicacion, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Nueva ubicación" />
                    <TextBlock
                        x:Name="PuntoText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Busca la dirección arriba del mapa y ajusta el punto con un clic."
                        TextWrapping="Wrap" />
                    <TextBox x:Name="NombreUbicacionTextBox" Header="Nombre *" />
                    <TextBox x:Name="DescripcionUbicacionTextBox" Header="Descripción *" />
                    <TextBox
                        x:Name="DireccionUbicacionTextBox"
                        Header="Dirección *"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CiudadUbicacionTextBox" Header="Ciudad *" />
                        <TextBox
                            x:Name="EstadoUbicacionTextBox"
                            Grid.Column="1"
                            Header="Estado *" />
                    </Grid>
                    <TextBlock
                        x:Name="ErrorUbicacionText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="GuardarUbicacionButton"
                            MinWidth="100"
                            Click="GuardarUbicacion_Click"
                            Content="Guardar"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button
                            MinWidth="100"
                            Click="CancelarCreacion_Click"
                            Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
