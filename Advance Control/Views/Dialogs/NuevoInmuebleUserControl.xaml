<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Advance_Control.Views.Dialogs.NuevoInmuebleUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Advance_Control.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="20"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="4"
            FontWeight="SemiBold"
            Text="Identificador:" />
        <StackPanel
            Grid.Row="1"
            Margin="4,4,4,12"
            Orientation="Horizontal"
            Spacing="8">
            <TextBox
                x:Name="IdentificadorTextBox"
                Width="220"
                PlaceholderText="Dejar vacío para auto-generar (0001, 0002...)"
                Text="{x:Bind ViewModel.Identificador, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="SugerirIdentificadorButton"
                VerticalAlignment="Stretch"
                Click="SugerirIdentificadorButton_Click"
                Content="Sugerir"
                ToolTipService.ToolTip="Buscar el siguiente identificador numérico disponible" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Margin="4"
            FontWeight="SemiBold"
            Text="Tipo de inmueble:" />
        <ComboBox
            x:Name="TipoInmuebleComboBox"
            Grid.Row="3"
            Width="300"
            Margin="4,4,4,12"
            HorizontalAlignment="Left"
            PlaceholderText="Seleccionar tipo (opcional)"
            SelectionChanged="TipoInmuebleComboBox_SelectionChanged">
            <ComboBoxItem Content="Residencial" Tag="1" />
            <ComboBoxItem Content="Comercial" Tag="2" />
            <ComboBoxItem Content="Industrial" Tag="3" />
            <ComboBoxItem Content="Gubernamental" Tag="4" />
            <ComboBoxItem Content="Terreno" Tag="5" />
        </ComboBox>

        <TextBlock
            Grid.Row="4"
            Margin="4"
            FontWeight="SemiBold"
            Text="Superficie (m²):" />
        <TextBox
            x:Name="SuperficieTextBox"
            Grid.Row="5"
            Width="300"
            Margin="4,4,4,12"
            InputScope="Number"
            PlaceholderText="Opcional"
            Text="{x:Bind ViewModel.SuperficieText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Grid.Row="6"
            Margin="4"
            FontWeight="SemiBold"
            Text="Código postal:" />
        <TextBox
            x:Name="CodigoPostalTextBox"
            Grid.Row="7"
            Width="300"
            Margin="4,4,4,12"
            InputScope="Number"
            PlaceholderText="Opcional"
            Text="{x:Bind ViewModel.CodigoPostal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Grid.Row="8"
            Margin="4"
            FontWeight="SemiBold"
            Text="Descripción:" />
        <TextBox
            x:Name="DescripcionTextBox"
            Grid.Row="9"
            Width="300"
            Height="80"
            Margin="4,4,4,12"
            AcceptsReturn="True"
            PlaceholderText="Descripción del inmueble (opcional)"
            Text="{x:Bind ViewModel.Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <!--  Error Message Display  -->
        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="10"
            Margin="4,0,4,12"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <StackPanel
            Grid.Row="11"
            Margin="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="SaveButton"
                Click="SaveButton_Click"
                Content="Guardar"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Click="CancelButton_Click"
                Content="Cancelar"/>
        </StackPanel>
    </Grid>
</UserControl>
