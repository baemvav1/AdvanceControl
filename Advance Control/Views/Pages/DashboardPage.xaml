<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                ══════════════════════════════════════════
                Hero: Bienvenida al usuario
                ══════════════════════════════════════════
            -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FechaHoy, Mode=OneWay}" />
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <Run Text="{x:Bind ViewModel.Saludo, Mode=OneWay}" />
                    <Run Text=", " />
                    <Run
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.NombreUsuario, Mode=OneWay}" />
                    <Run Text="." />
                </TextBlock>
            </StackPanel>

            <!--
                ══════════════════════════════════════════
                Separador
                ══════════════════════════════════════════
            -->
            <Border
                Grid.Row="1"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" />

            <!--
                ══════════════════════════════════════════
                Sección: Ops, pendientes por resolver, filtrado según el
                nivel del usuario (todo / solo su área / solo lo suyo).
                ══════════════════════════════════════════
            -->
            <StackPanel Grid.Row="3" Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowOps, Mode=OneWay}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Ops" />

                <Grid x:Name="Ops">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Card: operaciones abiertas (no t-Finalizado)  -->
                    <Grid x:Name="OpsAbiertasPendientes" Grid.Column="0">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsAbiertasPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE9F5;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Operaciones abiertas" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsAbiertasPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Card: t-Finalizado, todavía sin facturar  -->
                    <Grid x:Name="OpsTfinalizadoPendientes" Grid.Column="2">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsTFinalizadoPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Por facturar" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsTFinalizadoPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Card: facturadas, todavía sin cobrar  -->
                    <Grid x:Name="OpsFinalizadasPendientes" Grid.Column="4">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsFinalizadasPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE8C7;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Por cobrar" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsFinalizadasPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>

            <!--
                ══════════════════════════════════════════
                Sección: Noticias / Tareas / Alarmas (próximamente)
                ══════════════════════════════════════════
            -->
            <Pivot Grid.Row="5" Margin="-12,0,0,0">
                <PivotItem Header="Noticias">
                    <RichTextBlock
                        Margin="12,20,0,0"
                        MaxWidth="820"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        LineHeight="20">
                        <RichTextBlock.Blocks>
                            <Paragraph Margin="0,0,0,4">
                                <Run FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Novedades de octubre y noviembre 2026" />
                            </Paragraph>

                            <Paragraph Margin="0,4,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Portal de Clientes" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Ya está en línea el Portal de Clientes web: el cliente consulta sus operaciones, firma o rechaza hojas de mantenimiento, aprueba cotizaciones, carga su orden de compra, hace solicitudes y reporta emergencias." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Los accesos del portal se crean desde Clientes, en la pestaña Logins, y ahí mismo se puede ver el historial de accesos de cada login." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Facturación" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nueva factura desde cero (timbrado libre), sin partir de una operación." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Botón &quot;Importación automática&quot; en Facturas: trae las facturas emitidas en el portal FEL en Línea." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Buscador de Facturas con selector de campo: RFC, nombre comercial, folio (con serie) o UUID." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• El botón Nuevo ahora es un menú que incluye las cargas de XML." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Visor de factura: descarga del XML, comprobante de cancelación, pagos manuales en la pestaña Pagos y envío del historial con complementos y pagos." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Abonos y complementos de pago" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Al registrar un abono se valida el saldo y que la factura no esté cancelada." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• El complemento de pago generado desde abonos manuales toma la forma de pago, la referencia y la fecha de cada abono, y numera bien las parcialidades." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Conciliación bancaria" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• La conciliación ahora se calcula en el servidor: 1 a 1, varias a 1, abonos, complementos e ingresos manuales. Es más rápida y da el mismo resultado en todas las computadoras." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Reglas configurables con botón: DTC, RFC y Cheques." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Financiero y cobranza" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Financiero se reorganizó en tres grupos: Facturación, Bancos y Cobranza." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nueva Cobranza por cliente: historial, facturas, documentos, operaciones abiertas y T-Finalizado del cliente seleccionado." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• El reporte de cobranza ya no incluye facturas canceladas." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• En Por facturar cada operación muestra si ya tiene orden de compra." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Operaciones" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Visor de operaciones rediseñado." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Operaciones recuperadas: botón &quot;Op Recuperada&quot; y folio visible con R." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Nuevo Reporte ejecutivo de operaciones." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• El check de la operación guarda quién marcó cada paso y cuándo." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Áreas y ubicaciones" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Las áreas de Estado y Municipio guardan su contorno real." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Las ubicaciones quedan asignadas a su área automáticamente según el mapa, y el filtro por área en Ubicaciones ya funciona." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Entorno de pruebas y seguridad" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• En el login se puede elegir entre Producción y Pruebas. Pruebas usa una copia de los datos para practicar sin afectar nada." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Modo mantenimiento para trabajos delicados: mientras está activo solo entra el área de sistemas." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Las fotos y documentos guardados ahora solo se abren con una sesión válida." />
                            </Paragraph>

                            <Paragraph Margin="0,16,0,4">
                                <Run FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="En pruebas (próximamente)" />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Personal asignado por cliente (técnicos, supervisores y administrativos): define quién ve sus operaciones y órdenes de servicio, se copia en sus correos y recibe avisos de emergencias, órdenes nuevas, respuestas a cotizaciones y hojas de mantenimiento." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Chat: lista de chats al abrir la cortina, mensaje de difusión a todos, botón en verde con mensajes sin leer y reconexión automática." />
                            </Paragraph>
                            <Paragraph Margin="0,0,0,2">
                                <Run Text="• Asistente de Equipos: buscar un equipo y ver en un solo lugar sus clientes, contactos, personal, mapa y operaciones." />
                            </Paragraph>

                        </RichTextBlock.Blocks>
                    </RichTextBlock>
                </PivotItem>
                <PivotItem Header="Tareas">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
                <PivotItem Header="Alarmas">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
            </Pivot>

        </Grid>
    </ScrollViewer>
</Page>
