<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Advance_Control.Views.Dialogs.MovimientoVisorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Advance_Control.Models"
    Title="Movimiento bancario"
    CloseButtonText="Cerrar"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
        <Style x:Key="EtiquetaStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SeccionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MinWidth="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" Padding="0,0,12,0">

            <!-- Encabezado: monto, fecha y tipo -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Fila.AbonoTexto}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Encabezado}" />

            <!-- Movimiento -->
            <TextBlock Style="{StaticResource SeccionStyle}" Text="Movimiento" />
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Descripción" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Fila.Grupo.Descripcion}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="{x:Bind EtiquetaRfcReferencia}" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ValorOGuion(Fila.RfcReferencia)}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Banco emisor" />
                    <TextBlock Text="{x:Bind ValorOGuion(Fila.Banco)}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Referencia" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ValorOGuion(Fila.Grupo.Referencia)}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Estado" />
                    <TextBlock Text="{x:Bind Fila.Grupo.ConciliadoTexto}" />
                </StackPanel>
            </Grid>

            <!-- Cuenta que recibió el pago -->
            <TextBlock Style="{StaticResource SeccionStyle}" Text="Cuenta receptora" />
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Banco" />
                    <TextBlock Text="{x:Bind ValorOGuion(Fila.EstadoCuenta.NombreBanco)}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Cuenta" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Fila.EstadoCuenta.CuentaTitulo}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Titular" />
                    <TextBlock Text="{x:Bind ValorOGuion(Fila.EstadoCuenta.Titular)}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Style="{StaticResource EtiquetaStyle}" Text="Periodo del estado de cuenta" />
                    <TextBlock Text="{x:Bind Fila.EstadoCuenta.PeriodoTexto}" />
                </StackPanel>
            </Grid>

            <!-- Metadatos -->
            <TextBlock Style="{StaticResource SeccionStyle}" Text="Metadatos" />
            <TextBlock
                IsTextSelectionEnabled="True"
                Text="{x:Bind ValorOGuion(Fila.MetadatosTooltip)}"
                TextWrapping="Wrap" />

            <!-- Movimientos relacionados (solo si existen) -->
            <TextBlock
                Style="{StaticResource SeccionStyle}"
                Text="Movimientos relacionados"
                Visibility="{x:Bind TieneRelacionados}" />
            <ItemsControl ItemsSource="{x:Bind Fila.Grupo.MovimientosRelacionados}" Visibility="{x:Bind TieneRelacionados}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:EstadoCuentaMovimientoRelacionadoDetalleDto">
                        <Grid Padding="0,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Descripcion}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RfcTexto}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind MontoTexto}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
