                                        x:Name="Cbx_Otros_Extintor_Verificacion"
                                        Grid.Row="7"
                                        Grid.Column="2"
                                        Style="{StaticResource ItemCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="Cbx_Otros_Extintor_Ajuste"
