<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Advance_Control.Views.Formularios.MantenimientoPreventivoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Advance_Control.Views.Formularios"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>

            <Style x:Key="CampoCortoStyle" TargetType="TextBox">
                <Setter Property="Width" Value="170" />
                <Setter Property="Margin" Value="0,0,12,12" />
            </Style>
            <Style x:Key="CampoMedioStyle" TargetType="TextBox">
                <Setter Property="Width" Value="260" />
                <Setter Property="Margin" Value="0,0,12,12" />
            </Style>
            <Style x:Key="CampoAnchoStyle" TargetType="TextBox">
                <Setter Property="Width" Value="360" />
                <Setter Property="Margin" Value="0,0,12,12" />
            </Style>
            <Style x:Key="SeccionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!--  Fila de checklist de mantenimiento preventivo  -->
            <DataTemplate x:Key="ChecklistItemTemplate" x:DataType="local:ChecklistItem">
                <Grid Padding="6,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Texto}"
                        TextWrapping="Wrap" />
                    <RadioButton Grid.Column="1" HorizontalAlignment="Center" Padding="0" MinWidth="0" GroupName="{x:Bind Id}" IsChecked="{x:Bind NoAplica, Mode=TwoWay}" />
                    <RadioButton Grid.Column="2" HorizontalAlignment="Center" Padding="0" MinWidth="0" GroupName="{x:Bind Id}" IsChecked="{x:Bind Verificacion, Mode=TwoWay}" />
                    <RadioButton Grid.Column="3" HorizontalAlignment="Center" Padding="0" MinWidth="0" GroupName="{x:Bind Id}" IsChecked="{x:Bind Ajuste, Mode=TwoWay}" />
                    <RadioButton Grid.Column="4" HorizontalAlignment="Center" Padding="0" MinWidth="0" GroupName="{x:Bind Id}" IsChecked="{x:Bind Limpieza, Mode=TwoWay}" />
                    <RadioButton Grid.Column="5" HorizontalAlignment="Center" Padding="0" MinWidth="0" GroupName="{x:Bind Id}" IsChecked="{x:Bind Lubricacion, Mode=TwoWay}" />
                    <RadioButton Grid.Column="6" HorizontalAlignment="Center" Padding="0" MinWidth="0" GroupName="{x:Bind Id}" IsChecked="{x:Bind Recorrido, Mode=TwoWay}" />
                </Grid>
            </DataTemplate>

            <!--  Encabezado de columnas para las tablas de mantenimiento preventivo (se repite por sección)  -->
            <DataTemplate x:Key="ChecklistHeaderTemplate">
                <Grid Padding="6,6" Background="{ThemeResource CardStrokeColorDefaultSolid}" CornerRadius="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Ítem" />
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Text="No aplica" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Verificación" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Ajuste" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Limpieza" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Lubricación" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Grid.Column="6" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Recorrido" TextWrapping="Wrap" TextAlignment="Center" />
                </Grid>
            </DataTemplate>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Encabezado  -->
        <Grid
            Grid.Row="0"
            Padding="20,14"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Mantenimiento Preventivo" />
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Formulario visual (aún no guarda información ni consulta datos)." />
                <TextBlock
                    x:Name="DirigidoATextBlock"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!--  Contenido  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <!--
                Columnas "*" a los lados: cuando el contenido central (Auto) entra en el
                viewport, se reparten el espacio sobrante y lo centran; cuando el viewport
                es más angosto que el contenido, colapsan a 0 y el ScrollViewer habilita el
                scroll horizontal. Esto se recalcula en cada Arrange (incluido maximizar),
                a diferencia de ScrollViewer.HorizontalContentAlignment, que no se
                re-centraba de forma confiable al maximizar.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="1"
                    Padding="20"
                    MinWidth="960"
                    MaxWidth="1400"
                    Spacing="10">

                <Expander Header="Datos Generales" IsExpanded="True" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="4,10" Spacing="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ProyectoTextBox" Header="Proyecto" Style="{StaticResource CampoMedioStyle}" />
                            <TextBox x:Name="DireccionTextBox" Header="Dirección" Style="{StaticResource CampoAnchoStyle}" />
                            <TextBox x:Name="RutaTextBox" Header="Ruta" Style="{StaticResource CampoCortoStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NoEquipoTextBox" Header="No. Equipo" Style="{StaticResource CampoCortoStyle}" />
                            <TextBox x:Name="RefeEquipoTextBox" Header="Refe. Equipo" Style="{StaticResource CampoCortoStyle}" />
                            <TextBox x:Name="FechaTextBox" Header="Fecha" Style="{StaticResource CampoCortoStyle}" />
                            <TextBox x:Name="HoraEntradaTextBox" Header="Hora de entrada" Style="{StaticResource CampoCortoStyle}" />
                            <TextBox x:Name="HoraSalidaTextBox" Header="Hora de salida" Style="{StaticResource CampoCortoStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="Cabina" IsExpanded="True" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="0,6">
                        <ContentControl ContentTemplate="{StaticResource ChecklistHeaderTemplate}" HorizontalContentAlignment="Stretch" />
                        <ItemsRepeater ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind CabinaChecklist}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <Expander Header="Cuarto de Máquinas" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="0,6">
                        <ContentControl ContentTemplate="{StaticResource ChecklistHeaderTemplate}" HorizontalContentAlignment="Stretch" />
                        <ItemsRepeater ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind CuartoMaquinasChecklist}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <Expander Header="Foso" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="0,6">
                        <ContentControl ContentTemplate="{StaticResource ChecklistHeaderTemplate}" HorizontalContentAlignment="Stretch" />
                        <ItemsRepeater ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind FosoChecklist}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <Expander Header="Pasillo" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="0,6">
                        <ContentControl ContentTemplate="{StaticResource ChecklistHeaderTemplate}" HorizontalContentAlignment="Stretch" />
                        <ItemsRepeater ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind PasilloChecklist}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <Expander Header="Techo de Cabina" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="0,6">
                        <ContentControl ContentTemplate="{StaticResource ChecklistHeaderTemplate}" HorizontalContentAlignment="Stretch" />
                        <ItemsRepeater ItemTemplate="{StaticResource ChecklistItemTemplate}" ItemsSource="{x:Bind TechoCabinaChecklist}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <Expander Header="Evidencia Fotográfica" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="4,10" Spacing="10">
                        <Border
                            Padding="20"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon HorizontalAlignment="Center" Symbol="Camera" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Arrastra imágenes aquí o usa el botón para agregar evidencia" />
                                <Button HorizontalAlignment="Center" Content="Agregar fotografía" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander Header="Resumen de Asistencia y Observaciones" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="4,10" Spacing="8">
                        <TextBox
                            x:Name="ObservacionesTextBox"
                            AcceptsReturn="True"
                            Header="Resumen de asistencia, material, irregularidades de seguridad o comentarios"
                            Height="110"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,0,12,12" Spacing="4">
                            <TextBlock Text="Situación final del equipo" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="SituacionOperativoRadioButton" Content="Operativo" GroupName="rbGroup41" />
                                <RadioButton x:Name="SituacionDetenidoRadioButton" Content="Detenido" GroupName="rbGroup41" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="Confirmaciones" Style="{StaticResource SeccionExpanderStyle}">
                    <StackPanel Padding="4,10" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Firmas" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="TecnicoNombreTextBlock" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Width="320" Height="90" HorizontalAlignment="Left" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <TextBlock x:Name="FirmaTecnicoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Firma del técnico" />
                                        <Image x:Name="FirmaTecnicoImage" Margin="8" Stretch="Uniform" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Firma del cliente" />
                                <Border Width="320" Height="90" HorizontalAlignment="Left" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Firma del cliente" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Pie de ventana  -->
        <Grid
            Grid.Row="2"
            Padding="20,12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="EstadoFinalizarTextBlock"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    FontStyle="Italic"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Los checklists y observaciones no se guardan hasta presionar Finalizar." />
                <Button Click="CerrarButton_Click" Content="Cerrar" />
                <Button
                    x:Name="FinalizarButton"
                    Click="FinalizarButton_Click"
                    Content="Finalizar"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
