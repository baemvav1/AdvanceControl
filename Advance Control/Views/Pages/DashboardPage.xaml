<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Advance_Control.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                ══════════════════════════════════════════
                Hero: Bienvenida al usuario
                ══════════════════════════════════════════
            -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FechaHoy, Mode=OneWay}" />
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <Run Text="{x:Bind ViewModel.Saludo, Mode=OneWay}" />
                    <Run Text=", " />
                    <Run
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.NombreUsuario, Mode=OneWay}" />
                    <Run Text="." />
                </TextBlock>
            </StackPanel>

            <!--
                ══════════════════════════════════════════
                Separador
                ══════════════════════════════════════════
            -->
            <Border
                Grid.Row="1"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" />

            <!--
                ══════════════════════════════════════════
                Sección: Ops, pendientes por resolver, filtrado según el
                nivel del usuario (todo / solo su área / solo lo suyo).
                ══════════════════════════════════════════
            -->
            <StackPanel Grid.Row="3" Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowOps, Mode=OneWay}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Ops" />

                <Grid x:Name="Ops">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Card: operaciones abiertas (no t-Finalizado)  -->
                    <Grid x:Name="OpsAbiertasPendientes" Grid.Column="0">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsAbiertasPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE9F5;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Operaciones abiertas" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsAbiertasPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Card: t-Finalizado, todavía sin facturar  -->
                    <Grid x:Name="OpsTfinalizadoPendientes" Grid.Column="2">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsTFinalizadoPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Por facturar" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsTFinalizadoPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Card: facturadas, todavía sin cobrar  -->
                    <Grid x:Name="OpsFinalizadasPendientes" Grid.Column="4">
                        <Border
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="OpsFinalizadasPendientes_Tapped">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE8C7;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Por cobrar" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.OpsFinalizadasPendientesCount, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.IsOpsLoading, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>

            <!--
                ══════════════════════════════════════════
                Sección: Noticias / Tareas / Alarmas (próximamente)
                ══════════════════════════════════════════
            -->
            <Pivot Grid.Row="5" Margin="-12,0,0,0">
                <PivotItem Header="Noticias">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
                <PivotItem Header="Tareas">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
                <PivotItem Header="Alarmas">
                    <TextBlock
                        Margin="12,24,0,0"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Próximamente" />
                </PivotItem>
            </Pivot>

        </Grid>
    </ScrollViewer>
</Page>
