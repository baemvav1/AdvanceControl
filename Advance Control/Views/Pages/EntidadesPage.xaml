<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Advance_Control.Views.Pages.EntidadesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Advance_Control.Views.Controls"
    xmlns:converters="using:Advance_Control.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Advance_Control.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToCornerRadiusConverter x:Key="BooleanToCornerRadiusConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToExpandTextConverter x:Key="BooleanToExpandTextConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0" Margin="0,0,0,24" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    FontSize="32" FontWeight="Bold" Text="Entidades" />
                <Button
                    x:Name="Nuevo" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    Click="NuevoButton_Click" ToolTipService.ToolTip="Crear nueva entidad">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </StackPanel>
            <TextBlock
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Gestión de entidades del sistema" />
        </StackPanel>

        <!--  Filtros  -->
        <StackPanel
            Grid.Row="1" Margin="0,0,0,16" Spacing="12">
            <TextBlock
                FontSize="16" FontWeight="SemiBold" Text="Filtros de búsqueda" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Name="NombreComercialAutoSuggestBox"
                    Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Header="Nombre Comercial"
                    PlaceholderText="Nombre comercial"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.NombreComercialFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <AutoSuggestBox
                    x:Name="RazonSocialAutoSuggestBox"
                    Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" Header="Razón Social"
                    PlaceholderText="Razón social"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.RazonSocialFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <AutoSuggestBox
                    x:Name="RfcAutoSuggestBox"
                    Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" Header="RFC"
                    PlaceholderText="RFC de la entidad"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.RfcFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <AutoSuggestBox
                    x:Name="EstadoAutoSuggestBox"
                    Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Header="Estado"
                    PlaceholderText="Estado"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.EstadoFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <AutoSuggestBox
                    x:Name="CiudadAutoSuggestBox"
                    Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" Header="Ciudad"
                    PlaceholderText="Ciudad"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.CiudadFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel
                    Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                    <Button Click="ClearButton_Click" Content="Limpiar"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Lista de entidades  -->
        <Grid Grid.Row="2">
            <!--  Loading indicator  -->
            <ProgressRing
                Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!--  ItemsRepeater con ScrollViewer  -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Paginacion.PageItems, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate xmlns:models="using:Advance_Control.Models" x:DataType="models:EntidadDto">
                            <Grid Margin="0,5,20,5">
                                <StackPanel Orientation="Vertical">
                                    <Grid
                                        Grid.Row="0" MinHeight="90" Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" 
                                        CornerRadius="{x:Bind Expand, Converter={StaticResource BooleanToCornerRadiusConverter}, ConverterParameter='8,8,0,0|8', Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        x:Name="Head">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Información principal de la entidad  -->
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock
                                                FontSize="16" FontWeight="SemiBold"
                                                Text="{x:Bind RazonSocial}" />
                                            <TextBlock
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind NombreComercial}" />
                                            <StackPanel Orientation="Horizontal" Spacing="20">
                                                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="RFC: " />
                                                    <Run FontWeight="SemiBold" Text="{x:Bind RFC}" />
                                                </TextBlock>
                                                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Ciudad: " />
                                                    <Run Text="{x:Bind Ciudad}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border
                                                    Padding="8,2"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="Certificado de Sello Digital, usado para timbrar CFDI">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{x:Bind CsdCargado, Mode=OneWay, Converter={StaticResource NotificationColorConverter}}"
                                                        Text="{x:Bind CsdIndicadorTexto, Mode=OneWay}" />
                                                </Border>
                                                <Border
                                                    Padding="8,2"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="PFX generado a partir de la FIEL, usado para cancelar CFDI">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{x:Bind PfxCargado, Mode=OneWay, Converter={StaticResource NotificationColorConverter}}"
                                                        Text="{x:Bind PfxIndicadorTexto, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Acciones + botón para expandir/colapsar  -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="EditarButton_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Editar entidad">
                                                <SymbolIcon Symbol="Edit" />
                                            </Button>
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CertificadoButton_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Certificado de Sello Digital (CSD)">
                                                <SymbolIcon Symbol="Document" />
                                            </Button>
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PfxButton_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Generar y guardar PFX (FIEL) para cancelación de CFDI">
                                                <SymbolIcon Symbol="Permissions" />
                                            </Button>
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="ToggleExpandButton_Click"
                                                Tag="{x:Bind}"
                                                Content="{x:Bind Expand, Converter={StaticResource BooleanToExpandTextConverter}, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid
                                        Grid.Row="1" 
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                        CornerRadius="{x:Bind Expand, Converter={StaticResource BooleanToCornerRadiusConverter}, ConverterParameter='0,0,8,8|0', Mode=OneWay}"
                                        Visibility="{x:Bind Expand, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                        Padding="8"
                                        x:Name="Body">
                                        <Pivot>
                                            <!-- Información de Dirección -->
                                            <PivotItem Header="Dirección">
                                                <Grid Padding="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Calle:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Calle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4,0,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Colonia:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Colonia}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Núm. Exterior:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind NumExt}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Núm. Interior:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind NumInt}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CP:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind CP}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Estado:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Estado}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ciudad:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Ciudad}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="País:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Pais}" />
                                                    </StackPanel>
                                                </Grid>
                                            </PivotItem>
                                            
                                            <!-- Información Legal -->
                                            <PivotItem Header="Legal">
                                                <Grid Padding="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="RFC:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind RFC}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4,0,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Apoderado:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Apoderado}" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Régimen Fiscal:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind RegimenFiscal}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Estatus:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Estatus}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,8,0">
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ID Entidad:" />
                                                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind IdEntidad}" />
                                                    </StackPanel>
                                                </Grid>
                                            </PivotItem>

                                            <!-- Configs CFDI: catálogos editables de Régimen Fiscal y Uso de CFDI (SAT, CFDI 4.0) -->
                                            <PivotItem Header="Configs CFDI">
                                                <StackPanel
                                                    x:Name="ConfigsCfdiPanel"
                                                    Padding="8"
                                                    Loaded="ConfigsCfdiPanel_Loaded"
                                                    Spacing="16" />
                                            </PivotItem>
                                        </Pivot>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <controls:PaginacionFooterControl Grid.Row="3" Paginador="{x:Bind ViewModel.Paginacion, Mode=OneWay}" />
    </Grid>
</Page>
